---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import RelatedDocs from "../components/RelatedDocs.astro";
import LangToggle from "../components/LangToggle.astro";
import CrossLinks from "../components/CrossLinks.astro";
import CookieConsent from "../components/CookieConsent.astro";
import ShortcutHelp from "../components/ShortcutHelp.svelte";
import { tools } from "../lib/tools";
import type { Lang } from "../i18n/index";
import { getCommon } from "../i18n/common";
import { getHowTo } from "../i18n/howto";
import { faqs } from "../i18n/faq";

interface Props {
  title: string;
  description: string;
  activeToolId: string;
  lang?: Lang;
  schemaType?: "SoftwareApplication" | "Article" | "CollectionPage";
  docsPublishedAt?: Date;
  docsUpdatedAt?: Date;
  docsCategory?: string;
  docsTags?: string[];
}

const { title, description, activeToolId, lang = "en", schemaType = "SoftwareApplication", docsPublishedAt, docsUpdatedAt, docsCategory, docsTags } = Astro.props;
const c = getCommon(lang);

// Build-time month for "Last verified" footer + per-tool stamp (Bloque 1b —
// previously hardcoded to "May 2026", now reflects the actual deploy month).
const MONTHS_EN = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const MONTHS_ES = ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"];
const buildDate = new Date();
const monthYear = lang === "es"
  ? `${MONTHS_ES[buildDate.getMonth()]} ${buildDate.getFullYear()}`
  : `${MONTHS_EN[buildDate.getMonth()]} ${buildDate.getFullYear()}`;
const lastVerifiedFooter = c.footerLastVerified.replace("{{month}}", monthYear);
const lastVerifiedTool = c.toolLastVerified.replace("{{month}}", monthYear);

// Methodology URL — bridge target for Organization.publishingPrinciples and
// isPartOf on per-page schemas (Bloque 1c+1d).
const methodologyUrl = lang === "es" ? "https://pingthat.dev/es/methodology/" : "https://pingthat.dev/methodology/";

const authorUrl = lang === "es" ? "https://pingthat.dev/es/about/" : "https://pingthat.dev/about/";
const authorPerson = { "@type": "Person", name: "Marco B.", url: authorUrl };

const activeTool = tools.find(t => t.id === activeToolId);
// For resolved tools, tool.path is the EN canonical path. For unresolved
// (compare pages, docs), Astro.url.pathname is the full request path already
// including /es/ when present. Strip that prefix to get the "bare" EN path.
const pathnameBare = Astro.url.pathname.replace(/^\/es\//, '/').replace(/^\/es$/, '/');
const toolPath = activeTool?.path ?? pathnameBare;
const canonicalPath = lang === "es" ? `/es${toolPath}` : toolPath;
const withSlash = (p: string) => p.endsWith('/') ? p : p + '/';
const canonicalUrl = `https://pingthat.dev${withSlash(canonicalPath)}`;
const enUrl = `https://pingthat.dev${withSlash(toolPath)}`;
const esUrl = `https://pingthat.dev${withSlash('/es' + toolPath)}`;

const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "/es" || Astro.url.pathname === "/es/";
// Page-type detection for schema-appropriate markup.
const normalizedPath = Astro.url.pathname.replace(/^\/es\//, '/').replace(/\/$/, '');
const isLegalPage = normalizedPath === "/privacy-policy";
const isComparePage = normalizedPath.startsWith("/vs-");
const isDocsArticle = schemaType === "Article" && !!docsPublishedAt;
const isDocsHub = activeToolId === "docs" && !isDocsArticle;

type SchemaObject = Record<string, unknown>;
let primarySchema: SchemaObject;
if (isLegalPage || isComparePage) {
  primarySchema = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    url: canonicalUrl,
    description,
    inLanguage: lang,
    isPartOf: { "@type": "WebSite", name: "PingThat", url: "https://pingthat.dev" },
    author: authorPerson,
  };
} else if (isDocsArticle) {
  primarySchema = {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    url: canonicalUrl,
    description,
    inLanguage: lang,
    datePublished: docsPublishedAt!.toISOString(),
    dateModified: (docsUpdatedAt ?? docsPublishedAt!).toISOString(),
    author: authorPerson,
    publisher: {
      "@type": "Organization",
      name: "PingThat",
      logo: { "@type": "ImageObject", url: "https://pingthat.dev/og-image.png" },
    },
    mainEntityOfPage: canonicalUrl,
    articleSection: docsCategory,
    keywords: docsTags?.join(", "),
    image: "https://pingthat.dev/og-image.png",
    isPartOf: { "@type": "WebSite", name: "PingThat", url: "https://pingthat.dev" },
  };
} else if (isDocsHub) {
  primarySchema = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    url: canonicalUrl,
    description,
    inLanguage: lang,
    isPartOf: { "@type": "WebSite", name: "PingThat", url: "https://pingthat.dev" },
    author: authorPerson,
  };
} else {
  primarySchema = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: title,
    url: canonicalUrl,
    description,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Any",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    isPartOf: [
      { "@type": "WebApplication", name: "PingThat", url: "https://pingthat.dev" },
      { "@type": "WebPage", "@id": methodologyUrl, url: methodologyUrl, name: lang === "es" ? "Metodología" : "Methodology" },
    ],
    author: authorPerson,
  };
}

const docsHubPath = lang === "es" ? "/es/docs/" : "/docs/";
const docsHubLabel = lang === "es" ? "Guías" : "Guides";
const breadcrumbItems = isDocsArticle
  ? [
      { "@type": "ListItem", position: 1, name: "PingThat", item: `https://pingthat.dev${lang === "es" ? "/es/" : "/"}` },
      { "@type": "ListItem", position: 2, name: docsHubLabel, item: `https://pingthat.dev${docsHubPath}` },
      { "@type": "ListItem", position: 3, name: title, item: canonicalUrl },
    ]
  : [
      { "@type": "ListItem", position: 1, name: "PingThat", item: `https://pingthat.dev${lang === "es" ? "/es/" : "/"}` },
      ...(!isHome ? [{ "@type": "ListItem", position: 2, name: title, item: canonicalUrl }] : []),
    ];
const schemas: SchemaObject[] = [
  primarySchema,
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbItems,
  },
  // Organization schema with publishingPrinciples → methodology (Bloque 1c).
  // Emitted on every page so search engines see the site-level E-E-A-T bridge
  // regardless of which URL they crawl first.
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "PingThat",
    url: "https://pingthat.dev/",
    logo: "https://pingthat.dev/og-image.png",
    email: "support@pingthat.dev",
    publishingPrinciples: methodologyUrl,
    actionableFeedbackPolicy: `${methodologyUrl}#reporting-errors`,
  },
];

// HowTo schema removed 2026-04-27 — Google deprecated non-recipe HowTo
// rich-results in Aug 2023. i18n/howto.ts data kept for in-page rendering.
// FAQPage block kept (still useful for AI/Bing ingestion + topical relevance).
if (!isLegalPage && !isComparePage && !isHome && !isDocsArticle && !isDocsHub) {
  // FAQPage for top 5 tools (see i18n/faq.ts)
  if (faqs[activeToolId]) {
    const faqContent = faqs[activeToolId][lang];
    if (faqContent) {
      schemas.push({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        inLanguage: lang,
        mainEntity: faqContent.faqs.map(f => ({
          "@type": "Question",
          name: f.question,
          acceptedAnswer: { "@type": "Answer", text: f.answer },
        })),
      });
    }
  }
}

if (isHome) {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "PingThat",
    url: "https://pingthat.dev",
    description: "Free network tools: IP lookup, privacy check, WebRTC leak test, subnet calculator, JWT decoder and more.",
    inLanguage: ["en", "es"],
  });
  // (Home-only Organization schema removed — the top-level Organization
  // emitted on every page above already carries publishingPrinciples.)
}

const jsonLd = JSON.stringify(schemas);

const ogType = isLegalPage ? "website" : "article";
const ogLocale = lang === "es" ? "es_ES" : "en_US";
const ogLocaleAlternate = lang === "es" ? "en_US" : "es_ES";
import fs from "node:fs";
import path from "node:path";
const FONTS_CSS = fs.readFileSync(path.resolve("public/fonts/fonts.css"), "utf-8");
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0f172a" />
  <meta name="author" content="Marco B." />
  <meta name="google-adsense-account" content="ca-pub-8761907366448308" />

  <!-- Google Analytics 4 — Consent Mode v2. Default deny; Funding Choices CMP updates. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500,
    });
      // [GEO-GATE-V1] analytics_storage stays denied for EU/EEA/UK; granted elsewhere.
      // Fires inside wait_for_update window (500ms) so non-EU pings still flow.
      // CF /cdn-cgi/trace responds <100ms — well within the budget.
      fetch("/cdn-cgi/trace").then(function(r){return r.text();}).then(function(t){
        var m = t.match(/loc=([A-Z]{2})/);
        var cc = m ? m[1] : "";
        var EU = ["AT","BE","BG","CY","CZ","DE","DK","EE","ES","FI","FR","GR","HR","HU","IE","IT","LT","LU","LV","MT","NL","PL","PT","RO","SE","SI","SK","GB","UK","IS","LI","NO","CH"];
        if (cc && EU.indexOf(cc) === -1) {
          gtag("consent","update",{analytics_storage:"granted"});
        }
      }).catch(function(){});
    gtag('js', new Date());
    gtag('config', 'G-MRBSLR79JG', { anonymize_ip: true });
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-MRBSLR79JG"></script>

  <!-- Preconnect to AdSense origins to shave ~50-100ms off the first ad request -->
  <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
  <link rel="preconnect" href="https://fundingchoicesmessages.google.com" crossorigin />
  <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
  <link rel="dns-prefetch" href="https://adservice.google.com" />

  <!-- Google Funding Choices (CMP) + AdSense — both deferred via idle callback.
       FC must load before AdSense (TCF v2.2 / CCPA signaling), so we chain:
       idle → FC → onload/onerror → AdSense. PSI desktop showed FC alone costs
       ~97KB unused JS at boot; deferring it cuts TBT by 200-400ms. -->
  <script is:inline>
    (function () {
      function signalGooglefcPresent() {
        if (!window.frames['googlefcPresent']) {
          if (document.body) {
            var iframe = document.createElement('iframe');
            iframe.style = 'width: 0; height: 0; border: none; z-index: -1000; left: -1000px; top: -1000px;';
            iframe.style.display = 'none';
            iframe.name = 'googlefcPresent';
            document.body.appendChild(iframe);
          } else {
            setTimeout(signalGooglefcPresent, 0);
          }
        }
      }
      function loadAdsStack() {
        signalGooglefcPresent();
        var fc = document.createElement("script");
        fc.async = true;
        fc.src = "https://fundingchoicesmessages.google.com/i/pub-8761907366448308?ers=1";
        fc.onload = fc.onerror = function () {
          var ad = document.createElement("script");
          ad.async = true;
          ad.crossOrigin = "anonymous";
          ad.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8761907366448308";
          document.head.appendChild(ad);
        };
        document.head.appendChild(fc);
      }
      if ("requestIdleCallback" in window) {
        requestIdleCallback(loadAdsStack, { timeout: 3000 });
      } else {
        window.addEventListener("load", function () { setTimeout(loadAdsStack, 2000); });
      }
    })();
  </script>

  <title>{title} — PingThat</title>
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts (self-hosted). latin-ext loaded on-demand via fonts.css unicode-range —
       preloading it blocks FCP on EN/ES (which use latin only). -->
  <style is:inline set:html={FONTS_CSS}></style>
  <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Open Graph -->
  <meta property="og:title" content={`${title} — PingThat`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="PingThat" />
  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:locale:alternate" content={ogLocaleAlternate} />
  <meta property="og:image" content="https://pingthat.dev/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="PingThat — Free network tools for developers" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} — PingThat`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://pingthat.dev/og-image.png" />

  <!-- Hreflang alternates -->
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="es" href={esUrl} />
  <link rel="alternate" hreflang="x-default" href={enUrl} />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={jsonLd} />

  <!-- Theme init (prevent flash) -->
  <script is:inline>
    (function() {
      var t = localStorage.getItem('pingthat-theme');
      if (t === 'light') {
        document.documentElement.classList.add('light');
      }
    })();
  </script>
</head>
<body>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:rounded focus:text-sm focus:font-medium" style="background: var(--color-accent); color: #fff;">Skip to content</a>
  <div class="flex min-h-screen">
    <!-- Sidebar -->
    <Sidebar activeToolId={activeToolId} lang={lang} />

    <!-- Main content -->
    <div class="flex-1 flex flex-col min-w-0">
      <!-- Header -->
      <header class="sticky top-0 z-30 flex items-center justify-between gap-2 px-4 sm:px-6 py-3 border-b border-[var(--color-border)]" style="background: var(--color-bg);">
        <div class="flex items-center gap-2 min-w-0 flex-1">
          <button id="menu-toggle" class="lg:hidden p-2 rounded text-[var(--color-text-muted)] hover:text-[var(--color-text)] shrink-0" aria-label={lang === 'es' ? 'Abrir menú' : 'Open menu'} aria-expanded="false" aria-controls="sidebar">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
          {isComparePage || isLegalPage || isDocsHub || isDocsArticle ? (
            <span class="text-sm font-medium text-[var(--color-text)] truncate">{title}</span>
          ) : (
            <h1 class="text-sm font-medium text-[var(--color-text)] truncate">{title}</h1>
          )}
        </div>
        <div class="flex items-center gap-2 shrink-0" style="min-height: 28px;">
          <LangToggle
            lang={lang}
            enPath={withSlash(toolPath)}
            esPath={withSlash('/es' + toolPath)}
          />
          <span class="header-badge badge badge-accent" style="min-width: 180px; text-align: center;">{c.noDataCollectedPrivate}</span>
        </div>
      </header>
      <style is:global>
        /* .badge sets display: inline-flex in global.css, which wins over
           Tailwind's .hidden. Force-hide the header badge below sm. */
        @media (max-width: 639px) {
          .header-badge { display: none !important; }
        }
      </style>

      <!--
        Tool-page maintenance stamp — Stanford T-06 (CW audit 2026-05-03).
        Only renders on actual tool pages (not docs, legal, compare, home).
        Sits between the sticky header and the tool component so a cold
        visitor sees the freshness signal before deciding to interact.
      -->
      {activeToolId && activeToolId !== "home" && activeToolId !== "compare" && activeToolId !== "docs" && !isLegalPage && !isDocsArticle && !isDocsHub && (
        <div class="px-4 sm:px-6 py-1.5 border-b border-[var(--color-border)]" style="background: var(--color-surface); font-size: 11px; color: var(--color-text-muted);">
          <div class="flex items-center gap-2">
            <span aria-hidden="true" style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--color-accent);"></span>
            <span>{lastVerifiedTool}</span>
          </div>
        </div>
      )}

      <!-- Content -->
      <main id="main-content" class="flex-1">
        <slot />
        {activeToolId && activeToolId !== "home" && activeToolId !== "compare" && activeToolId !== "docs" && !isLegalPage && (
          <RelatedDocs toolId={activeToolId} lang={lang} />
        )}
        <!-- Ad banner -->
        <div class="shrink-0 px-6 py-3 border-t border-[var(--color-border)]" style="min-height: 100px;">
          <div class="mx-auto max-w-[728px]" style="min-height: 90px;">
            <ins class="adsbygoogle"
                 style="display:block; min-height: 90px;"
                 data-ad-client="ca-pub-8761907366448308"
                 data-ad-slot="1667159287"
                 data-ad-format="horizontal"
                 data-full-width-responsive="true"></ins>
          </div>
        </div>
        <CrossLinks exclude="dev" lang={lang} />
      </main>

      <!-- Footer -->
      <footer class="px-6 py-4 border-t border-[var(--color-border)] text-[11px] text-[var(--color-text-dim)]">
        <div class="flex justify-between items-center mb-2">
          <span>{c.networkToolsForDevs}</span>
          <span class="flex items-center gap-2 flex-wrap">
            <a href={lang === "es" ? "/es/about/" : "/about/"} class="hover:text-[var(--color-accent)] transition-colors inline-block py-1">{lang === "es" ? "Acerca de" : "About"}</a>
            <span style="color: var(--color-border);">&middot;</span>
            <a href={lang === "es" ? "/es/contact/" : "/contact/"} class="hover:text-[var(--color-accent)] transition-colors inline-block py-1">{lang === "es" ? "Contacto" : "Contact"}</a>
            <span style="color: var(--color-border);">&middot;</span>
            <a href={lang === "es" ? "/es/privacy-policy/" : "/privacy-policy/"} class="hover:text-[var(--color-accent)] transition-colors inline-block py-1">{lang === "es" ? "Privacidad" : "Privacy"}</a>
            <a href={lang === "es" ? "/es/methodology/" : "/methodology/"} class="hover:text-[var(--color-accent)] transition-colors inline-block py-1">{c.footerMethodology}</a>
            <span style="color: var(--color-border);">&middot;</span>
            <a href={lang === "es" ? "/es/terms/" : "/terms/"} class="hover:text-[var(--color-accent)] transition-colors inline-block py-1">{lang === "es" ? "Términos" : "Terms"}</a>
            <span style="color: var(--color-border);">&middot;</span>
            <a href="https://buymeacoffee.com/allopen" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-accent)] transition-colors inline-block py-1">{c.buyMeACoffee}</a>
          </span>
        </div>
        <!--
          Identity strip — Stanford Web Credibility signals.
          Three short lines that survive the 5-second cold-visitor test:
          (1) maintainer + since-year answers "is this abandoned?"
          (2) visible email is the highest-weight Stanford signal for
              independent sites
          (3) last-verified stamp tells the user the tools are checked
              against current standards
          Strings live in i18n/common.ts so the warm-dark v2 footer can
          re-arrange them without prose churn.
        -->
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-2 text-[var(--color-text-muted)]" style="font-size: 11px;">
          <span>{c.footerMaintainedBy} · <span style="color: var(--color-text-dim);">{c.footerSince}</span></span>
          <span style="color: var(--color-border);">&middot;</span>
          <a href={`mailto:${c.footerSupportEmail}?subject=${encodeURIComponent('PingThat — ' + (lang === 'es' ? 'consulta' : 'support'))}`}
             class="hover:text-[var(--color-accent)] transition-colors inline-block py-1"
             title={c.footerSupportEmailSub}>{c.footerSupportEmail}</a>
          <span style="color: var(--color-border);">&middot;</span>
          <span title={c.footerSupportEmailSub} style="color: var(--color-text-dim);">{lastVerifiedFooter}</span>
        </div>
        <form id="feedback-form" action="https://formspree.io/f/mpqoddwl" method="POST" class="flex gap-2">
          <input type="hidden" name="app" value="PingThat" />
          <input type="hidden" name="page" value="" />
          <input type="hidden" name="_subject" value="" />
          <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
          <input type="text" name="message" placeholder={c.feedbackPlaceholder} required
            aria-label={c.feedbackPlaceholder}
            class="flex-1 px-3 py-1.5 rounded text-[11px]"
            style="background: var(--color-surface2); border: 1px solid var(--color-border); color: var(--color-text); font-family: 'Inter', sans-serif;"
          />
          <button type="submit" class="px-3 py-1.5 rounded text-[10px] uppercase tracking-wider"
            style="background: var(--color-surface2); border: 1px solid var(--color-border); color: var(--color-text-muted); cursor: pointer;">
            {c.send}
          </button>
        </form>
      </footer>
    </div>
  </div>

  <CookieConsent lang={lang} />

  <!-- Mobile sidebar toggle -->
  <script>
    const toggle = document.getElementById('menu-toggle');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebar-overlay');

    function openSidebar() {
      sidebar?.classList.remove('-translate-x-full');
      overlay?.classList.remove('hidden');
      toggle?.setAttribute('aria-expanded', 'true');
    }
    function closeSidebar() {
      sidebar?.classList.add('-translate-x-full');
      overlay?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    }

    toggle?.addEventListener('click', openSidebar);
    overlay?.addEventListener('click', closeSidebar);
  </script>

  <!-- Input guards -->
  <script>
    const NUMBER_MAX = 999_999_999_999;
    document.addEventListener('input', (e) => {
      const el = e.target;
      if (el instanceof HTMLInputElement && el.type === 'number') {
        if (!el.step) el.step = 'any';
        const v = parseFloat(el.value);
        if (v > NUMBER_MAX) el.value = String(NUMBER_MAX);
        if (v < -NUMBER_MAX) el.value = String(-NUMBER_MAX);
      }
    });
  </script>

  <!-- Feedback form: AJAX submit + toast (no page reload) -->
  <script>
    (function () {
      const form = document.getElementById('feedback-form');
      if (!(form instanceof HTMLFormElement)) return;

      const isEs = document.documentElement.lang === 'es';
      const MSG = {
        success: isEs ? '¡Gracias por tu feedback!' : 'Thanks for your feedback!',
        error: isEs ? 'Error al enviar. Inténtalo más tarde.' : 'Error sending. Please try again later.',
      };

      function showToast(text, isError) {
        const toast = document.createElement('div');
        toast.setAttribute('role', 'status');
        toast.setAttribute('aria-live', 'polite');
        toast.textContent = text;
        Object.assign(toast.style, {
          position: 'fixed',
          bottom: '24px',
          left: '50%',
          transform: 'translate(-50%, 20px)',
          padding: '12px 20px',
          borderRadius: '8px',
          background: isError ? '#dc2626' : '#059669',
          color: '#fff',
          fontSize: '13px',
          fontWeight: '500',
          fontFamily: 'Inter, sans-serif',
          zIndex: '9999',
          boxShadow: '0 10px 30px rgba(0,0,0,0.35)',
          opacity: '0',
          transition: 'opacity .25s ease, transform .25s ease',
          cursor: 'pointer',
          maxWidth: '90vw',
        });
        toast.title = isEs ? 'Clic para cerrar' : 'Click to dismiss';
        document.body.appendChild(toast);
        requestAnimationFrame(() => {
          toast.style.opacity = '1';
          toast.style.transform = 'translate(-50%, 0)';
        });
        let dismissed = false;
        const dismiss = () => {
          if (dismissed) return;
          dismissed = true;
          toast.style.opacity = '0';
          toast.style.transform = 'translate(-50%, 20px)';
          setTimeout(() => toast.remove(), 300);
        };
        toast.addEventListener('click', dismiss);
        setTimeout(dismiss, 5000);
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = form.querySelector('button[type="submit"]');
        const data = new FormData(form);
        data.set('page', location.href);
        const appName = String(data.get('app') || 'PingThat');
        data.set('_subject', `[${appName}] ${location.pathname}`);
        if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;
        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: data,
            headers: { Accept: 'application/json' },
          });
          if (res.ok) {
            showToast(MSG.success, false);
            form.reset();
          } else {
            showToast(MSG.error, true);
          }
        } catch {
          showToast(MSG.error, true);
        } finally {
          if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
        }
      });
    })();
  </script>

  <!-- Global keyboard-shortcut help (Nielsen re-audit 2026-05-01: H7).
       Same pattern shipped to AY/JC. client:only because the listener
       attaches to document at onMount. -->
  <ShortcutHelp client:only="svelte" lang={lang} />
</body>
</html>
