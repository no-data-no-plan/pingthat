---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import { tools } from "../lib/tools";

interface Props {
  title: string;
  description: string;
  activeToolId: string;
}

const { title, description, activeToolId } = Astro.props;

const activeTool = tools.find(t => t.id === activeToolId);
const keywords = activeTool?.keywords.join(", ") ?? "";
const canonicalUrl = `https://pingthat.dev${activeTool?.path ?? Astro.url.pathname}`;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: title,
  url: canonicalUrl,
  description,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  browserRequirements: "Requires a modern web browser",
  isPartOf: {
    "@type": "WebApplication",
    name: "PingThat",
    url: "https://pingthat.dev",
  },
});
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="theme-color" content="#0f172a" />
  <meta name="google-adsense-account" content="ca-pub-8761907366448308" />
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8761907366448308" crossorigin="anonymous"></script>

  <title>{title} — PingThat</title>
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" href="https://fonts.gstatic.com/s/inter/v18/UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuLyfAZ9hjQ.woff2" as="font" type="font/woff2" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Open Graph -->
  <meta property="og:title" content={`${title} — PingThat`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="PingThat" />
  <meta property="og:type" content="website" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} — PingThat`} />
  <meta name="twitter:description" content={description} />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={jsonLd} />

  <!-- Theme init (prevent flash) -->
  <script is:inline>
    (function() {
      var t = localStorage.getItem('pingthat-theme');
      if (t === 'light') {
        document.documentElement.classList.add('light');
      }
    })();
  </script>
</head>
<body>
  <div class="flex min-h-screen">
    <!-- Sidebar -->
    <Sidebar activeToolId={activeToolId} />

    <!-- Main content -->
    <div class="flex-1 flex flex-col min-w-0">
      <!-- Header -->
      <header class="sticky top-0 z-30 flex items-center justify-between px-6 py-3 border-b border-[var(--color-border)]" style="background: var(--color-bg);">
        <div class="flex items-center gap-3">
          <button id="menu-toggle" class="lg:hidden p-2 rounded text-[var(--color-text-muted)] hover:text-[var(--color-text)]">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
          <div>
            <h1 class="text-sm font-medium text-[var(--color-text)]">{title}</h1>
          </div>
        </div>
        <div class="flex items-center gap-3" style="min-height: 28px;">
          <span class="hidden sm:inline badge badge-accent" style="min-width: 180px; text-align: center;">No data collected &middot; 100% private</span>
        </div>
      </header>

      <!-- Content -->
      <main class="flex-1">
        <slot />
      </main>

      <!-- Footer -->
      <footer class="px-6 py-4 border-t border-[var(--color-border)] text-[11px] text-[var(--color-text-dim)]">
        <div class="flex justify-between items-center mb-2">
          <span>PingThat — Network tools for developers</span>
          <span class="flex items-center gap-2">
            <a href="https://buymeacoffee.com/allopen" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-accent)] transition-colors">Buy me a coffee</a>
            <span style="color: var(--color-border);">&middot;</span>
            <span>100% private</span>
          </span>
        </div>
        <form action="https://formspree.io/f/mpqoddwl" method="POST" class="flex gap-2">
          <input type="hidden" name="app" value="PingThat" />
          <input type="text" name="message" placeholder="Bug, idea, or feedback..." required
            class="flex-1 px-3 py-1.5 rounded text-[11px]"
            style="background: var(--color-surface2); border: 1px solid var(--color-border); color: var(--color-text); font-family: 'Inter', sans-serif;"
          />
          <button type="submit" class="px-3 py-1.5 rounded text-[10px] uppercase tracking-wider"
            style="background: var(--color-surface2); border: 1px solid var(--color-border); color: var(--color-text-muted); cursor: pointer;">
            Send
          </button>
        </form>
      </footer>
    </div>
  </div>

  <!-- Mobile sidebar toggle -->
  <script>
    const toggle = document.getElementById('menu-toggle');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebar-overlay');

    function openSidebar() {
      sidebar?.classList.remove('-translate-x-full');
      overlay?.classList.remove('hidden');
    }
    function closeSidebar() {
      sidebar?.classList.add('-translate-x-full');
      overlay?.classList.add('hidden');
    }

    toggle?.addEventListener('click', openSidebar);
    overlay?.addEventListener('click', closeSidebar);
  </script>

  <!-- Input guards -->
  <script>
    const NUMBER_MAX = 999_999_999_999;
    document.addEventListener('input', (e) => {
      const el = e.target;
      if (el instanceof HTMLInputElement && el.type === 'number') {
        if (!el.step) el.step = 'any';
        const v = parseFloat(el.value);
        if (v > NUMBER_MAX) el.value = String(NUMBER_MAX);
        if (v < -NUMBER_MAX) el.value = String(-NUMBER_MAX);
      }
    });
  </script>
</body>
</html>
