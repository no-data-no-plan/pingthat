---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import CrossLinks from "../components/CrossLinks.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { tools } from "../lib/tools";
import type { Lang } from "../i18n/index";
import { getCommon } from "../i18n/common";

interface Props {
  title: string;
  description: string;
  activeToolId: string;
  lang?: Lang;
}

const { title, description, activeToolId, lang = "en" } = Astro.props;
const c = getCommon(lang);

const activeTool = tools.find(t => t.id === activeToolId);
const keywords = activeTool?.keywords.join(", ") ?? "";
const toolPath = activeTool?.path ?? Astro.url.pathname;
const canonicalPath = lang === "es" ? `/es${toolPath}` : toolPath;
const withSlash = (p: string) => p.endsWith('/') ? p : p + '/';
const canonicalUrl = `https://pingthat.dev${withSlash(canonicalPath)}`;
const enUrl = `https://pingthat.dev${withSlash(toolPath)}`;
const esUrl = `https://pingthat.dev${withSlash('/es' + toolPath)}`;

const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "/es" || Astro.url.pathname === "/es/";

const schemas: object[] = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: title,
    url: canonicalUrl,
    description,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Any",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    isPartOf: { "@type": "WebApplication", name: "PingThat", url: "https://pingthat.dev" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "PingThat", item: `https://pingthat.dev${lang === "es" ? "/es" : ""}` },
      ...(!isHome ? [{ "@type": "ListItem", position: 2, name: title, item: canonicalUrl }] : []),
    ],
  },
];

if (isHome) {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "PingThat",
    url: "https://pingthat.dev",
    description: "Free network tools: IP lookup, privacy check, WebRTC leak test, subnet calculator, JWT decoder and more.",
    inLanguage: ["en", "es"],
  });
}

const jsonLd = JSON.stringify(schemas);
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="theme-color" content="#0f172a" />
  <meta name="google-adsense-account" content="ca-pub-8761907366448308" />

  <title>{title} — PingThat</title>
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts (self-hosted) -->
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-latin-ext.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Open Graph -->
  <meta property="og:title" content={`${title} — PingThat`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="PingThat" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://pingthat.dev/og-image.png" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} — PingThat`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://pingthat.dev/og-image.png" />

  <!-- Hreflang alternates -->
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="es" href={esUrl} />
  <link rel="alternate" hreflang="x-default" href={enUrl} />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={jsonLd} />

  <!-- Theme init (prevent flash) -->
  <script is:inline>
    (function() {
      var t = localStorage.getItem('pingthat-theme');
      if (t === 'light') {
        document.documentElement.classList.add('light');
      }
    })();
  </script>
</head>
<body>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:rounded focus:text-sm focus:font-medium" style="background: var(--color-accent); color: #fff;">Skip to content</a>
  <div class="flex min-h-screen">
    <!-- Sidebar -->
    <Sidebar activeToolId={activeToolId} lang={lang} />

    <!-- Main content -->
    <div class="flex-1 flex flex-col min-w-0">
      <!-- Header -->
      <header class="sticky top-0 z-30 flex items-center justify-between px-6 py-3 border-b border-[var(--color-border)]" style="background: var(--color-bg);">
        <div class="flex items-center gap-3">
          <button id="menu-toggle" class="lg:hidden p-2 rounded text-[var(--color-text-muted)] hover:text-[var(--color-text)]">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
          <div>
            <h1 class="text-sm font-medium text-[var(--color-text)]">{title}</h1>
          </div>
        </div>
        <div class="flex items-center gap-3" style="min-height: 28px;">
          <a href={lang === "en" ? esUrl : enUrl} class="hidden sm:inline text-[11px] px-2 py-1 rounded border border-[var(--color-border)] text-[var(--color-text-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] transition-colors" style="text-decoration: none; font-weight: 500;">
            {lang === "en" ? "ES" : "EN"}
          </a>
          <span class="hidden sm:inline badge badge-accent" style="min-width: 180px; text-align: center;">{c.noDataCollectedPrivate}</span>
        </div>
      </header>

      <!-- Content -->
      <main id="main-content" class="flex-1">
        <slot />
        <!-- Ad banner -->
        <div class="shrink-0 px-6 py-3 border-t border-[var(--color-border)]" style="min-height: 100px;">
          <div class="mx-auto max-w-[728px]" style="min-height: 90px;">
            <ins class="adsbygoogle"
                 style="display:block; min-height: 90px;"
                 data-ad-client="ca-pub-8761907366448308"
                 data-ad-slot="1667159287"
                 data-ad-format="horizontal"
                 data-full-width-responsive="true"></ins>
          </div>
        </div>
        <CrossLinks exclude="dev" lang={lang} />
      </main>

      <!-- Footer ad banner -->
      <div class="shrink-0 px-6 py-3 border-t border-[var(--color-border)]" style="min-height: 100px;">
        <div class="mx-auto max-w-[728px]" style="min-height: 90px;">
          <ins class="adsbygoogle"
               style="display:block; min-height: 90px;"
               data-ad-client="ca-pub-8761907366448308"
               data-ad-slot="1667159287"
               data-ad-format="horizontal"
               data-full-width-responsive="true"></ins>
        </div>
      </div>

      <!-- Footer -->
      <footer class="px-6 py-4 border-t border-[var(--color-border)] text-[11px] text-[var(--color-text-dim)]">
        <div class="flex justify-between items-center mb-2">
          <span>{c.networkToolsForDevs}</span>
          <span class="flex items-center gap-2">
            <a href="https://buymeacoffee.com/allopen" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-accent)] transition-colors">{c.buyMeACoffee}</a>
            <span style="color: var(--color-border);">&middot;</span>
            <span>{c.private100}</span>
          </span>
        </div>
        <form action="https://formspree.io/f/mpqoddwl" method="POST" class="flex gap-2">
          <input type="hidden" name="app" value="PingThat" />
          <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
          <input type="text" name="message" placeholder={c.feedbackPlaceholder} required
            class="flex-1 px-3 py-1.5 rounded text-[11px]"
            style="background: var(--color-surface2); border: 1px solid var(--color-border); color: var(--color-text); font-family: 'Inter', sans-serif;"
          />
          <button type="submit" class="px-3 py-1.5 rounded text-[10px] uppercase tracking-wider"
            style="background: var(--color-surface2); border: 1px solid var(--color-border); color: var(--color-text-muted); cursor: pointer;">
            {c.send}
          </button>
        </form>
      </footer>
    </div>
  </div>

  <CookieConsent lang={lang} />

  <!-- Mobile sidebar toggle -->
  <script>
    const toggle = document.getElementById('menu-toggle');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebar-overlay');

    function openSidebar() {
      sidebar?.classList.remove('-translate-x-full');
      overlay?.classList.remove('hidden');
    }
    function closeSidebar() {
      sidebar?.classList.add('-translate-x-full');
      overlay?.classList.add('hidden');
    }

    toggle?.addEventListener('click', openSidebar);
    overlay?.addEventListener('click', closeSidebar);
  </script>

  <!-- Input guards -->
  <script>
    const NUMBER_MAX = 999_999_999_999;
    document.addEventListener('input', (e) => {
      const el = e.target;
      if (el instanceof HTMLInputElement && el.type === 'number') {
        if (!el.step) el.step = 'any';
        const v = parseFloat(el.value);
        if (v > NUMBER_MAX) el.value = String(NUMBER_MAX);
        if (v < -NUMBER_MAX) el.value = String(-NUMBER_MAX);
      }
    });
  </script>
</body>
</html>
