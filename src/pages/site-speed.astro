---
import Layout from "../layouts/Layout.astro";
import SiteSpeed from "../components/SiteSpeed.svelte";
import SeoContent from "../components/SeoContent.astro";
import SeoBlock from "../components/SeoBlock.astro";
import { pageI18n } from "../i18n/pages";

const p = pageI18n["site-speed"].en;
---

<Layout title={p.title} description={p.description} activeToolId="site-speed">
  <SiteSpeed client:only="svelte" />
  <SeoContent heading={p.seoHeading} text={p.seoText} relatedToolIds={["is-it-up", "http-headers", "ssl-checker"]} />
  <SeoBlock heading={p.seoBlockHeading} text={p.seoBlockText} features={p.seoFeatures} />
</Layout>
