---
import Layout from "../layouts/Layout.astro";
import IsItUp from "../components/IsItUp.svelte";
import SeoContent from "../components/SeoContent.astro";
import SeoBlock from "../components/SeoBlock.astro";
import { pageI18n } from "../i18n/pages";

const p = pageI18n["is-it-up"].en;
---

<Layout
  title={p.title}
  description={p.description}
  activeToolId="is-it-up"
>
  <IsItUp client:only="svelte" />

  <SeoContent
    heading={p.seoHeading}
    text={p.seoText}
    relatedToolIds={["is-it-down", "http-headers", "ssl-checker"]}
  />

  <SeoBlock
    heading={p.seoBlockHeading}
    text={p.seoBlockText}
    features={p.seoFeatures}
  />
</Layout>
