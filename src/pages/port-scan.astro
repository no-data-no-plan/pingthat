---
import Layout from "../layouts/Layout.astro";
import PortScan from "../components/PortScan.svelte";
import SeoContent from "../components/SeoContent.astro";
import SeoBlock from "../components/SeoBlock.astro";
import ToolContent from "../components/ToolContent.astro";
import { pageI18n } from "../i18n/pages";

const p = pageI18n["port-scan"].en;
---

<Layout
  title={p.title}
  description={p.description}
  activeToolId="port-scan"
>
  <PortScan client:only="svelte" />

  <SeoContent
    heading={p.seoHeading}
    text={p.seoText}
    relatedToolIds={["ssl-checker", "http-headers", "is-it-up"]}
  />

  <ToolContent
    howHeading={p.howHeading}
    howSteps={p.howSteps}
    useCasesHeading={p.useCasesHeading}
    useCases={p.useCases}
    faqHeading={p.faqHeading}
    faqs={p.faqs}
  />

    <SeoBlock
    heading={p.seoBlockHeading}
    text={p.seoBlockText}
    features={p.seoFeatures}
  />
</Layout>
