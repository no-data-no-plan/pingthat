---
import "../styles/global.css";
import { tools, groups } from "../lib/tools";
import { getCommon } from "../i18n/common";
import CookieConsent from "../components/CookieConsent.astro";
import LangToggle from "../components/LangToggle.astro";

const c = getCommon("en");

// Build-time month for "Last verified" footer (Bloque 1b — CI-set, mirrors Layout.astro pattern).
const MONTHS_EN = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const _bd = new Date();
const monthYear = `${MONTHS_EN[_bd.getMonth()]} ${_bd.getFullYear()}`;
const lastVerifiedFooter = c.footerLastVerified.replace("{{month}}", monthYear);

const jsonLd = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "PingThat",
    url: "https://pingthat.dev",
    description: "Free privacy-first suite of 17 network & security tools — DNS, SSL, WHOIS, HTTP headers, JWT decoder, subnet calc. Runs in your browser.",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Any",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    inLanguage: ["en", "es"],
    author: { "@type": "Person", name: "Marco B.", url: "https://pingthat.dev/about/" },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "PingThat",
    url: "https://pingthat.dev",
    description: "Free network tools: IP lookup, privacy check, WebRTC leak test, subnet calculator, JWT decoder and more.",
    inLanguage: ["en", "es"],
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "PingThat",
    url: "https://pingthat.dev/",
    logo: "https://pingthat.dev/og-image.png",
    email: "support@pingthat.dev",
    description: "Free privacy-first suite of 23 network & security tools — DNS, SSL, WHOIS, HTTP headers, JWT decoder, subnet calc. Runs in your browser.",
    publishingPrinciples: "https://pingthat.dev/methodology/",
    actionableFeedbackPolicy: "https://pingthat.dev/methodology/#reporting-errors",
    sameAs: [
      "https://buymeacoffee.com/allopen",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "What does PingThat's DNS lookup tool do?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "PingThat offers a free DNS lookup tool as part of its collection of 17 network and security tools. It returns A, AAAA, MX, NS, TXT, and CNAME records instantly. All lookups query Cloudflare DoH and run in the browser; PingThat does not log query content. See /methodology/ for the per-tool breakdown.",
        },
      },
      {
        "@type": "Question",
        name: "How can I check if a website is down for everyone?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "PingThat includes an Is It Down tool that checks whether a website is reachable from the internet. Enter any URL to see its HTTP status, response time, and whether the site is down for everyone or just you.",
        },
      },
      {
        "@type": "Question",
        name: "Is there a free SSL certificate checker online?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "PingThat provides a free SSL certificate checker that shows certificate issuer, expiration date, chain validity, and protocol details. No installation required — it runs directly in your browser.",
        },
      },
      {
        "@type": "Question",
        name: "What free tools can I use to check HTTP headers?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "PingThat includes an HTTP Headers tool that displays all response headers for any URL, including security headers like Content-Security-Policy, HSTS, and X-Frame-Options. Results are shown instantly with no data stored.",
        },
      },
      {
        "@type": "Question",
        name: "Can I decode a JWT token online safely?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Yes. PingThat has a JWT decoder that parses and displays the header, payload, and signature of any JWT token. The decoding happens entirely client-side — your token never leaves your browser and no data is sent to any server.",
        },
      },
    ],
  },
]);
import fs from "node:fs";
import path from "node:path";
const FONTS_CSS = fs.readFileSync(path.resolve("public/fonts/fonts.css"), "utf-8");
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Free privacy-first suite of 17 network & security tools — DNS, SSL, WHOIS, HTTP headers, JWT decoder, subnet calc. Runs in your browser." />
  <meta name="theme-color" content="#0f172a" />
  <meta name="author" content="Marco B." />
  <meta name="google-adsense-account" content="ca-pub-8761907366448308" />

  <!-- Google Analytics 4 — Consent Mode v2. Default deny; CMP updates consent. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500,
    });
      // [GEO-GATE-V1] analytics_storage stays denied for EU/EEA/UK; granted elsewhere.
      // Fires inside wait_for_update window (500ms) so non-EU pings still flow.
      // CF /cdn-cgi/trace responds <100ms — well within the budget.
      fetch("/cdn-cgi/trace").then(function(r){return r.text();}).then(function(t){
        var m = t.match(/loc=([A-Z]{2})/);
        var cc = m ? m[1] : "";
        var EU = ["AT","BE","BG","CY","CZ","DE","DK","EE","ES","FI","FR","GR","HR","HU","IE","IT","LT","LU","LV","MT","NL","PL","PT","RO","SE","SI","SK","GB","UK","IS","LI","NO","CH"];
        if (cc && EU.indexOf(cc) === -1) {
          gtag("consent","update",{analytics_storage:"granted"});
        }
      }).catch(function(){});
    gtag('js', new Date());
    gtag('config', 'G-MRBSLR79JG', { anonymize_ip: true });
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-MRBSLR79JG"></script>

  <!-- Preconnect to AdSense origins -->
  <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
  <link rel="preconnect" href="https://fundingchoicesmessages.google.com" crossorigin />
  <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
  <link rel="dns-prefetch" href="https://adservice.google.com" />

  <!-- Google Funding Choices CMP — loads BEFORE AdSense. No UI outside regulated regions. -->
  <script async src="https://fundingchoicesmessages.google.com/i/pub-8761907366448308?ers=1"></script>
  <script is:inline>
    (function() { function signalGooglefcPresent() { if (!window.frames['googlefcPresent']) { if (document.body) { const iframe = document.createElement('iframe'); iframe.style = 'width: 0; height: 0; border: none; z-index: -1000; left: -1000px; top: -1000px;'; iframe.style.display = 'none'; iframe.name = 'googlefcPresent'; document.body.appendChild(iframe); } else { setTimeout(signalGooglefcPresent, 0); } } } signalGooglefcPresent(); })();
  </script>

  <!-- Google AdSense — CMP (above) controls consent per region -->
    <script is:inline>
  // Defer AdSense load until after LCP (idle callback or post-load timeout).
  // Funding Choices CMP loads synchronously above to satisfy GDPR; AdSense
  // can wait. Saves ~100-150ms LCP on mobile (Lighthouse main-thread audit).
  (function () {
    function loadAdSense() {
      var s = document.createElement("script");
      s.async = true;
      s.crossOrigin = "anonymous";
      s.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8761907366448308";
      document.head.appendChild(s);
    }
    if ("requestIdleCallback" in window) {
      requestIdleCallback(loadAdSense, { timeout: 3000 });
    } else {
      window.addEventListener("load", function () { setTimeout(loadAdSense, 2000); });
    }
  })();
</script>

  <title>PingThat — Network Tools for Developers</title>
  <link rel="canonical" href="https://pingthat.dev/" />
  <link rel="alternate" hreflang="en" href="https://pingthat.dev/" />
  <link rel="alternate" hreflang="es" href="https://pingthat.dev/es/" />
  <link rel="alternate" hreflang="x-default" href="https://pingthat.dev/" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts (self-hosted). latin-ext only loaded on-demand via unicode-range
       in fonts.css — preloading it blocks FCP on EN/ES (which use latin only). -->
  <style is:inline set:html={FONTS_CSS}></style>
  <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

  <meta property="og:title" content="PingThat — Network Tools for Developers" />
  <meta property="og:description" content="PingThat is a free collection of 17 network and security tools — DNS lookup, SSL checker, WHOIS, HTTP headers, JWT decoder — that run in your browser or query public APIs (DoH/RDAP/cert logs)." />
  <meta property="og:url" content="https://pingthat.dev/" />
  <meta property="og:site_name" content="PingThat" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://pingthat.dev/og-image.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="PingThat — Network Tools for Developers" />
  <meta name="twitter:description" content="PingThat is a free collection of 17 network and security tools — DNS lookup, SSL checker, WHOIS, HTTP headers, JWT decoder — that run in your browser or query public APIs (DoH/RDAP/cert logs)." />
  <meta name="twitter:image" content="https://pingthat.dev/og-image.png" />

  <script type="application/ld+json" set:html={jsonLd} />
</head>
<body>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:rounded focus:text-sm focus:font-medium" style="background: var(--color-accent); color: var(--color-bg);">Skip to content</a>
  <div class="min-h-screen relative" style="background: var(--color-bg); color: var(--color-text);">

    <!-- Top-right: Guides + language toggle.
         Nielsen audit 2026-04-30 (PT F17): /about/ + /docs/ existed but were
         only reachable from tool-page chrome. Surfacing /docs/ here closes
         the discovery gap. -->
    <div class="absolute top-4 right-4 z-30 flex items-center gap-3">
      <a href="/docs/" class="text-[11px] hover:text-[var(--color-accent)] transition-colors" style="color: var(--color-text-muted);">Guides</a>
      <LangToggle lang="en" enPath="/" esPath="/es/" />
    </div>

    <!-- Hero. id="main-content" + tabindex="-1" so skip-link transfers
         keyboard focus here (without tabindex, browsers only scroll, focus
         stays on the skip link). Round-2 review fix 2026-04-30. -->
    <header id="main-content" tabindex="-1" class="px-6 py-16 sm:py-24 text-center max-w-3xl mx-auto">
      <p class="text-[10px] uppercase tracking-[0.2em] mb-4 font-semibold" style="color: var(--color-accent-fg);">{c.heroEyebrow}</p>
      <h1 class="text-4xl sm:text-5xl font-bold mb-4" style="color: var(--color-text);">
        {c.heroHeadingPrefix}<em class="italic" style="color: var(--color-accent-fg);">{c.heroHeadingEm}</em>
      </h1>
      <p class="text-sm sm:text-base leading-relaxed mb-8" style="color: var(--color-text-muted);">
        {c.heroText}
      </p>
      <!-- Hero search (Nielsen audit, PT F8). Mirrors sidebar-search filtering
           pattern but operates on home cards via data-tool-search attrs. -->
      <div class="max-w-xl mx-auto">
        <input
          id="home-search"
          type="search"
          placeholder={`Search ${tools.length} tools — DNS, SSL, HTTP headers, JWT, subnet...`}
          aria-label="Search tools"
          autocomplete="off"
          class="w-full px-4 py-3 rounded-lg text-sm"
          style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text);"
        />
      </div>
    </header>

    <!-- Tool Grid -->
    <main class="px-6 pb-16 max-w-5xl mx-auto">
      <p id="home-no-results" class="hidden text-center text-sm mb-8" style="color: var(--color-text-muted);">No tools match your search.</p>
      {groups.map((group) => (
        <section class="mb-12 home-group">
          <div class="flex items-center gap-3 mb-5">
            <h2 class="text-[10px] uppercase tracking-[0.15em] font-semibold" style="color: var(--color-accent-fg);">
              {group.label}
            </h2>
            <div class="flex-1 h-px" style="background: var(--color-border);"></div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {group.ids.map((id) => {
              const tool = tools.find(t => t.id === id);
              if (!tool) return null;
              const searchText = [tool.name, tool.description, tool.id, ...(tool.keywords || [])].join(' ').toLowerCase();
              return (
                <a
                  href={tool.path}
                  class="card group block transition-all hover:border-[var(--color-accent)] home-tool-card"
                  style="border: 1px solid var(--color-border);"
                  data-tool-search={searchText}
                >
                  <div class="card-body" style="padding: 20px;">
                    <div class="flex items-start gap-3">
                      <span
                        class="text-xs flex items-center justify-center w-9 h-9 rounded-lg shrink-0 font-semibold font-mono"
                        style="background: var(--color-accent-dim); color: var(--color-accent-fg); border: 1px solid rgba(16,185,129,0.15);"
                        aria-hidden="true"
                      >
                        {tool.icon}
                      </span>
                      <div class="flex-1 min-w-0">
                        <h3 class="text-sm font-medium mb-1 group-hover:text-[var(--color-accent)] transition-colors" style="color: var(--color-text);">
                          {tool.name}
                        </h3>
                        <p class="text-xs leading-relaxed" style="color: var(--color-text-muted);">
                          {tool.description}
                        </p>
                      </div>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ))}

      <!-- Bottom CTA -->
      <div class="text-center py-12" style="border-top: 1px solid var(--color-border);">
        <p class="text-[10px] uppercase tracking-[0.15em] mb-3" style="color: var(--color-text-dim);">
          {c.bottomCtaLabel}
        </p>
        <p class="text-xs" style="color: var(--color-text-muted);">
          {c.bottomCtaText}
        </p>
      </div>
    </main>
    <!-- Footer (Nielsen audit 2026-04-30, PT F3 + F17): match tool-page
         chrome. Pre-fix /about/, /docs/, BMC, and Formspree feedback were
         unreachable from `/`. -->
    <footer class="px-6 py-4 border-t border-[var(--color-border)] text-[11px]" style="color: var(--color-text-dim);">
      <div class="flex justify-between items-center mb-2 gap-3 flex-wrap">
        <span>{c.footerTagline}</span>
        <span class="flex items-center gap-2 flex-wrap">
          <a href="/about/" class="hover:text-[var(--color-accent)] transition-colors">About</a>
          <span style="color: var(--color-border);">·</span>
          <a href="/privacy-policy/" class="hover:text-[var(--color-accent)] transition-colors">{c.footerPrivacy}</a>
          <span style="color: var(--color-border);">·</span>
          <a href="/methodology/" class="hover:text-[var(--color-accent)] transition-colors">{c.footerMethodology}</a>
          <span style="color: var(--color-border);">·</span>
          <a href="/docs/" class="hover:text-[var(--color-accent)] transition-colors">Guides</a>
          <span style="color: var(--color-border);">·</span>
          <a href="https://buymeacoffee.com/allopen" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-accent)] transition-colors">Buy me a coffee</a>
        </span>
      </div>
      <!-- Identity strip — Stanford Web Credibility (T-02/T-04/T-06).
           Mirrors the strip in Layout.astro so the homepage and the
           tool-page chrome surface the same trust signals. -->
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-2" style="color: var(--color-text-muted); font-size: 11px;">
        <span>{c.footerMaintainedBy} · <span style="color: var(--color-text-dim);">{c.footerSince}</span></span>
        <span style="color: var(--color-border);">·</span>
        <a href={`mailto:${c.footerSupportEmail}?subject=${encodeURIComponent('PingThat — support')}`}
           class="hover:text-[var(--color-accent)] transition-colors inline-block py-1"
           title={c.footerSupportEmailSub}>{c.footerSupportEmail}</a>
        <span style="color: var(--color-border);">·</span>
        <span style="color: var(--color-text-dim);">{lastVerifiedFooter}</span>
      </div>
      <form id="feedback-form" action="https://formspree.io/f/mpqoddwl" method="POST" class="flex gap-2">
        <input type="hidden" name="app" value="PingThat" />
        <input type="hidden" name="page" value="" />
        <input type="hidden" name="_subject" value="" />
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
        <input type="text" name="message" placeholder="Bug, idea, or feedback..." required
          aria-label="Bug, idea, or feedback..."
          class="flex-1 px-3 py-1.5 rounded text-[11px]"
          style="background: var(--color-surface2); border: 1px solid var(--color-border); color: var(--color-text); font-family: 'Inter', sans-serif;"
        />
        <button type="submit" class="px-3 py-1.5 rounded text-[10px] uppercase tracking-wider"
          style="background: var(--color-surface2); border: 1px solid var(--color-border); color: var(--color-text-muted); cursor: pointer;">
          Send
        </button>
      </form>
    </footer>
  </div>
  <CookieConsent lang="en" />

  <!-- Feedback form: AJAX submit + toast (Nielsen audit code-review 2026-04-30).
       Without this, the form did a full-page POST to formspree.io. -->
  <script>
    (function () {
      const form = document.getElementById('feedback-form');
      if (!(form instanceof HTMLFormElement)) return;
      const isEs = document.documentElement.lang === 'es';
      const MSG = {
        success: isEs ? '¡Gracias por tu feedback!' : 'Thanks for your feedback!',
        error: isEs ? 'Error al enviar. Inténtalo más tarde.' : 'Error sending. Please try again later.',
      };
      function showToast(text: string, isError: boolean) {
        const toast = document.createElement('div');
        toast.setAttribute('role', 'status');
        toast.setAttribute('aria-live', 'polite');
        toast.textContent = text;
        Object.assign(toast.style, {
          position: 'fixed', bottom: '24px', left: '50%',
          transform: 'translate(-50%, 20px)', padding: '12px 20px',
          borderRadius: '8px', background: isError ? '#dc2626' : '#059669',
          color: '#fff', fontSize: '13px', fontWeight: '500', zIndex: '9999',
          boxShadow: '0 10px 30px rgba(0,0,0,0.35)', opacity: '0',
          transition: 'opacity .25s ease, transform .25s ease',
          cursor: 'pointer', maxWidth: '90vw',
        });
        toast.title = isEs ? 'Clic para cerrar' : 'Click to dismiss';
        document.body.appendChild(toast);
        requestAnimationFrame(() => {
          toast.style.opacity = '1';
          toast.style.transform = 'translate(-50%, 0)';
        });
        let dismissed = false;
        const dismiss = () => {
          if (dismissed) return;
          dismissed = true;
          toast.style.opacity = '0';
          toast.style.transform = 'translate(-50%, 20px)';
          setTimeout(() => toast.remove(), 300);
        };
        toast.addEventListener('click', dismiss);
        setTimeout(dismiss, 5000);
      }
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = form.querySelector('button[type="submit"]');
        const data = new FormData(form);
        data.set('page', location.href);
        const appName = String(data.get('app') || 'PingThat');
        data.set('_subject', `[${appName}] ${location.pathname}`);
        if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;
        try {
          const res = await fetch(form.action, {
            method: 'POST', body: data,
            headers: { Accept: 'application/json' },
          });
          if (res.ok) { showToast(MSG.success, false); form.reset(); }
          else { showToast(MSG.error, true); }
        } catch {
          showToast(MSG.error, true);
        } finally {
          if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
        }
      });
    })();
  </script>

  <!-- Hero search filter (Nielsen audit PT F8). Re-uses the same dataset
       attrs as Sidebar.astro but with a homepage-specific input id. -->
  <script>
    const heroInput = document.getElementById('home-search') as HTMLInputElement | null;
    const heroNoResults = document.getElementById('home-no-results');
    if (heroInput) {
      const apply = () => {
        const q = heroInput.value.toLowerCase().trim();
        let anyMatch = false;
        document.querySelectorAll<HTMLElement>('.home-tool-card').forEach((el) => {
          const text = el.dataset.toolSearch || '';
          const match = !q || text.includes(q);
          el.style.display = match ? '' : 'none';
          if (match) anyMatch = true;
        });
        document.querySelectorAll<HTMLElement>('.home-group').forEach((section) => {
          const visible = Array.from(section.querySelectorAll<HTMLElement>('.home-tool-card'))
            .some((c) => c.style.display !== 'none');
          section.style.display = visible ? '' : 'none';
        });
        if (heroNoResults) heroNoResults.classList.toggle('hidden', !q || anyMatch);
      };
      heroInput.addEventListener('input', apply);
      heroInput.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && heroInput.value) {
          heroInput.value = '';
          apply();
        }
      });
      // Cmd/Ctrl+K to focus.
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          heroInput.focus();
          heroInput.select();
        }
      });
    }
  </script>
</body>
</html>
