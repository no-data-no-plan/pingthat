---
import "../styles/global.css";
import { tools, groups } from "../lib/tools";
import { getCommon } from "../i18n/common";
import CookieConsent from "../components/CookieConsent.astro";
import CmdkPalette from "../components/CmdkPalette.astro";
import CrossLinks from "../components/CrossLinks.astro";
import LangToggle from "../components/LangToggle.astro";

const c = getCommon("en");

// Build-time month for "Last verified" footer (Bloque 1b — CI-set, mirrors Layout.astro pattern).
const MONTHS_EN = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const _bd = new Date();
const monthYear = `${MONTHS_EN[_bd.getMonth()]} ${_bd.getFullYear()}`;
const lastVerifiedFooter = c.footerLastVerified.replace("{{month}}", monthYear);

// Featured group + anchor slugs for the topbar nav (warm-dark redesign).
const GROUP_SLUG: Record<string, string> = {
  "Network": "network", "Security": "security",
  "Speed & Uptime": "speed", "Calculators": "calculators",
};
// Quick-access pills — 5 most-used tools (real tools.ts ids). G3 redesign.
const PILL_IDS = ["dns-lookup", "ssl-checker", "http-headers", "my-ip", "subnet-calculator"];
const pills = PILL_IDS.map((id) => tools.find((t) => t.id === id)).filter(Boolean);

const jsonLd = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "PingThat",
    url: "https://pingthat.dev",
    description: "Free privacy-first suite of 17 network & security tools — DNS, SSL, WHOIS, HTTP headers, JWT decoder, subnet calc. Runs in your browser.",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Any",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    inLanguage: ["en", "es"],
    author: { "@type": "Person", name: "Marco B.", url: "https://pingthat.dev/about/" },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "PingThat",
    url: "https://pingthat.dev",
    description: "Free network tools: IP lookup, privacy check, WebRTC leak test, subnet calculator, JWT decoder and more.",
    inLanguage: ["en", "es"],
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "PingThat",
    url: "https://pingthat.dev/",
    logo: "https://pingthat.dev/og-image.png",
    email: "support@pingthat.dev",
    description: "Free privacy-first suite of 23 network & security tools — DNS, SSL, WHOIS, HTTP headers, JWT decoder, subnet calc. Runs in your browser.",
    publishingPrinciples: "https://pingthat.dev/methodology/",
    actionableFeedbackPolicy: "https://pingthat.dev/methodology/#reporting-errors",
    sameAs: [
      "https://buymeacoffee.com/allopen",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "What does PingThat's DNS lookup tool do?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "PingThat offers a free DNS lookup tool as part of its collection of 17 network and security tools. It returns A, AAAA, MX, NS, TXT, and CNAME records instantly. All lookups query Cloudflare DoH and run in the browser; PingThat does not log query content. See /methodology/ for the per-tool breakdown.",
        },
      },
      {
        "@type": "Question",
        name: "How can I check if a website is down for everyone?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "PingThat includes an Is It Down tool that checks whether a website is reachable from the internet. Enter any URL to see its HTTP status, response time, and whether the site is down for everyone or just you.",
        },
      },
      {
        "@type": "Question",
        name: "Is there a free SSL certificate checker online?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "PingThat provides a free SSL certificate checker that shows certificate issuer, expiration date, chain validity, and protocol details. No installation required — it runs directly in your browser.",
        },
      },
      {
        "@type": "Question",
        name: "What free tools can I use to check HTTP headers?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "PingThat includes an HTTP Headers tool that displays all response headers for any URL, including security headers like Content-Security-Policy, HSTS, and X-Frame-Options. Results are shown instantly with no data stored.",
        },
      },
      {
        "@type": "Question",
        name: "Can I decode a JWT token online safely?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Yes. PingThat has a JWT decoder that parses and displays the header, payload, and signature of any JWT token. The decoding happens entirely client-side — your token never leaves your browser and no data is sent to any server.",
        },
      },
    ],
  },
]);
import fs from "node:fs";
import path from "node:path";
const FONTS_CSS = fs.readFileSync(path.resolve("public/fonts/fonts.css"), "utf-8");
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Free privacy-first suite of 17 network & security tools — DNS, SSL, WHOIS, HTTP headers, JWT decoder, subnet calc. Runs in your browser." />
  <meta name="theme-color" content="#141311" />
  <meta name="author" content="Marco B." />
  <meta name="google-adsense-account" content="ca-pub-8761907366448308" />

  <!-- Google Analytics 4 — Consent Mode v2. Default deny; CMP updates consent. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    // [PW-GUARD-V1] Skip GA4 init when running under browser automation
    // (Playwright, Selenium, Puppeteer). Diagnosed 2026-05-20: 6047 fake
    // "real" PV on CV /pro/ Apr 22-25 were our own Playwright e2e tests,
    // geoIP'd to "Parla" (Madrid POP). gtag() stays defined as no-op so
    // other call sites (tool-complete.svelte.ts etc.) don't crash.
    if (!(window.__PW_TEST__ || navigator.webdriver)) {
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500,
    });
      // [GEO-GATE-V1] analytics_storage stays denied for EU/EEA/UK; granted elsewhere.
      // Fires inside wait_for_update window (500ms) so non-EU pings still flow.
      // CF /cdn-cgi/trace responds <100ms — well within the budget.
      fetch("/cdn-cgi/trace").then(function(r){return r.text();}).then(function(t){
        var m = t.match(/loc=([A-Z]{2})/);
        var cc = m ? m[1] : "";
        var EU = ["AT","BE","BG","CY","CZ","DE","DK","EE","ES","FI","FR","GR","HR","HU","IE","IT","LT","LU","LV","MT","NL","PL","PT","RO","SE","SI","SK","GB","UK","IS","LI","NO","CH"];
        if (cc && EU.indexOf(cc) === -1) {
          gtag("consent","update",{analytics_storage:"granted"});
        }
      }).catch(function(){});
    gtag('js', new Date());
    gtag('config', 'G-MRBSLR79JG', { anonymize_ip: true });
    var _s=document.createElement('script');_s.async=true;_s.src='https://www.googletagmanager.com/gtag/js?id=G-MRBSLR79JG';document.head.appendChild(_s);
    }
  </script>

  <!-- Preconnect to AdSense origins -->
  <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
  <link rel="preconnect" href="https://fundingchoicesmessages.google.com" crossorigin />
  <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
  <link rel="dns-prefetch" href="https://adservice.google.com" />

  <!-- Google Funding Choices CMP — loads BEFORE AdSense. No UI outside regulated regions. -->
  <script async src="https://fundingchoicesmessages.google.com/i/pub-8761907366448308?ers=1"></script>
  <script is:inline>
    (function() { function signalGooglefcPresent() { if (!window.frames['googlefcPresent']) { if (document.body) { const iframe = document.createElement('iframe'); iframe.style = 'width: 0; height: 0; border: none; z-index: -1000; left: -1000px; top: -1000px;'; iframe.style.display = 'none'; iframe.name = 'googlefcPresent'; document.body.appendChild(iframe); } else { setTimeout(signalGooglefcPresent, 0); } } } signalGooglefcPresent(); })();
  </script>

  <!-- Google AdSense — CMP (above) controls consent per region -->
    <script is:inline>
  // Defer AdSense load until after LCP (idle callback or post-load timeout).
  // Funding Choices CMP loads synchronously above to satisfy GDPR; AdSense
  // can wait. Saves ~100-150ms LCP on mobile (Lighthouse main-thread audit).
  (function () {
    function loadAdSense() {
      var s = document.createElement("script");
      s.async = true;
      s.crossOrigin = "anonymous";
      s.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8761907366448308";
      document.head.appendChild(s);
    }
    if ("requestIdleCallback" in window) {
      requestIdleCallback(loadAdSense, { timeout: 3000 });
    } else {
      window.addEventListener("load", function () { setTimeout(loadAdSense, 2000); });
    }
  })();
</script>

  <title>PingThat — Network Tools for Developers</title>
  <link rel="canonical" href="https://pingthat.dev/" />
  <link rel="alternate" hreflang="en" href="https://pingthat.dev/" />
  <link rel="alternate" hreflang="es" href="https://pingthat.dev/es/" />
  <link rel="alternate" hreflang="x-default" href="https://pingthat.dev/" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts (self-hosted). latin-ext only loaded on-demand via unicode-range
       in fonts.css — preloading it blocks FCP on EN/ES (which use latin only). -->
  <style is:inline set:html={FONTS_CSS}></style>
  <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />

  <meta property="og:title" content="PingThat — Network Tools for Developers" />
  <meta property="og:description" content="PingThat is a free collection of 17 network and security tools — DNS lookup, SSL checker, WHOIS, HTTP headers, JWT decoder — that run in your browser or query public APIs (DoH/RDAP/cert logs)." />
  <meta property="og:url" content="https://pingthat.dev/" />
  <meta property="og:site_name" content="PingThat" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://pingthat.dev/og-image.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="PingThat — Network Tools for Developers" />
  <meta name="twitter:description" content="PingThat is a free collection of 17 network and security tools — DNS lookup, SSL checker, WHOIS, HTTP headers, JWT decoder — that run in your browser or query public APIs (DoH/RDAP/cert logs)." />
  <meta name="twitter:image" content="https://pingthat.dev/og-image.png" />

  <script type="application/ld+json" set:html={jsonLd} />

  <style>
    /* ── Homepage warm-dark redesign (stage-2) — uses global --color-* tokens ── */
    .pt-topbar { position: sticky; top: 0; z-index: 30; border-bottom: 1px solid var(--color-border);
      background: color-mix(in srgb, var(--color-bg) 82%, transparent); backdrop-filter: blur(12px); }
    .pt-topbar-inner { max-width: 1140px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 14px; min-height: 58px; }
    .pt-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: inherit; margin-right: auto; }
    .pt-brand svg { width: 22px; height: 22px; color: var(--color-accent-fg); flex: none; }
    .pt-brand-name { font-weight: 600; font-size: 15.5px; letter-spacing: -0.02em; color: var(--color-text); }
    .pt-nav { display: flex; align-items: center; gap: 2px; }
    .pt-nav a { font-size: 13px; color: var(--color-text-muted); text-decoration: none; padding: 8px 11px; border-radius: 7px;
      min-height: 36px; display: inline-flex; align-items: center; transition: color .15s, background .15s; }
    .pt-nav a:hover { color: var(--color-text); background: var(--color-surface); }
    .pt-badge { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--color-accent-fg);
      border: 1px solid var(--color-accent-edge); background: var(--color-accent-dim);
      padding: 5px 10px; border-radius: 999px; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
    .pt-badge .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-ok); }
    @media (max-width: 820px) { .pt-nav.cats, .pt-badge { display: none; } }

    .pt-hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--color-border); }
    .pt-hero::before { content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none;
      background:
        radial-gradient(circle at 1px 1px, rgba(244,241,234,0.035) 1px, transparent 0) 0 0 / 26px 26px,
        radial-gradient(105% 95% at 50% -25%, var(--color-accent-dim), transparent 58%);
      -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 55%, transparent 100%); }
    .pt-hero::after { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 1px; z-index: 0;
      background: linear-gradient(90deg, transparent, var(--color-accent-edge) 50%, transparent); }
    .pt-hero-inner { position: relative; z-index: 1; max-width: 760px; margin: 0 auto; padding: 80px 24px 60px; text-align: center; }
    .pt-eyebrow { display: inline-flex; align-items: center; gap: 9px; font-family: 'JetBrains Mono', monospace;
      font-size: 12px; color: var(--color-text-muted); border: 1px solid var(--color-border);
      background: var(--color-surface); padding: 6px 14px 6px 12px; border-radius: 999px; margin: 0 0 24px; }
    .pt-eyebrow .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-ok); box-shadow: 0 0 0 3px var(--color-ok-dim); }
    .pt-eyebrow b { color: var(--color-accent-fg); font-weight: 500; }
    .pt-h1 { font-size: clamp(34px, 6vw, 54px); line-height: 1.05; font-weight: 600; letter-spacing: -0.035em;
      margin: 0 auto 18px; max-width: 18ch; color: var(--color-text); }
    .pt-h1 em { font-style: normal; color: var(--color-accent-fg); }
    .pt-value { font-size: clamp(15px, 2.2vw, 18px); color: var(--color-text-muted); max-width: 54ch; margin: 0 auto 32px; line-height: 1.55; }

    .pt-search { max-width: 560px; margin: 0 auto; display: flex; align-items: center; gap: 10px; min-height: 52px;
      padding: 0 8px 0 16px; background: var(--color-surface); border: 1px solid var(--color-border2);
      border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.32); transition: border-color .15s, box-shadow .15s; }
    .pt-search:focus-within { border-color: var(--color-accent-fg); box-shadow: 0 0 0 3px var(--color-accent-dim), 0 10px 30px rgba(0,0,0,0.32); }
    .pt-search svg { width: 18px; height: 18px; color: var(--color-text-dim); flex: none; }
    .pt-search input { flex: 1; background: none; border: 0; outline: 0; color: var(--color-text);
      font-family: 'JetBrains Mono', monospace; font-size: 14.5px; min-width: 0; }
    .pt-search input::placeholder { color: var(--color-text-dim); }
    .pt-kbd { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--color-text-dim);
      border: 1px solid var(--color-border); border-radius: 6px; padding: 4px 8px; }

    .pt-pills { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 20px; }
    .pt-pill-lead { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--color-text-dim);
      text-transform: uppercase; letter-spacing: 0.13em; align-self: center; }
    .pt-pill { display: inline-flex; align-items: center; gap: 8px; min-height: 38px; padding: 0 14px; border-radius: 999px;
      background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text);
      text-decoration: none; font-size: 13.5px; font-weight: 500; transition: background .15s, border-color .15s, transform .15s; }
    .pt-pill .ico { font-family: 'JetBrains Mono', monospace; color: var(--color-accent-fg); font-size: 12px; }
    .pt-pill:hover { background: var(--color-surface2); border-color: var(--color-border2); transform: translateY(-1px); }
    @media (max-width: 600px) { .pt-pill-lead { display: none; } }

    /* Live readout — data strip in the site's mono register. dt/dd inline;
       the LED reuses the eyebrow dot language. Wraps gracefully on phones. */
    .pt-readout { display: flex; flex-wrap: wrap; justify-content: center; align-items: center;
      gap: 6px 18px; margin: 26px auto 0; padding: 10px 18px; max-width: fit-content;
      border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-surface); }
    .pt-ro-lead { display: inline-flex; align-items: center; gap: 7px;
      font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--color-text-dim);
      text-transform: uppercase; letter-spacing: 0.13em; }
    .pt-ro-lead .dot { width: 6px; height: 6px; border-radius: 50%;
      background: var(--color-ok); box-shadow: 0 0 0 3px var(--color-ok-dim); }
    .pt-ro-item { display: inline-flex; align-items: baseline; gap: 7px; margin: 0; }
    .pt-ro-item dt { font-family: 'JetBrains Mono', monospace; font-size: 10.5px;
      color: var(--color-text-dim); text-transform: uppercase; letter-spacing: 0.1em; }
    .pt-ro-item dd { margin: 0; font-family: 'JetBrains Mono', monospace; font-size: 13px;
      color: var(--color-text); }
    .pt-ro-link { font-family: 'JetBrains Mono', monospace; font-size: 11px;
      color: var(--color-accent-fg); text-decoration: none; border-bottom: 1px solid var(--color-border2); }
    .pt-ro-link:hover { border-color: var(--color-accent-fg); }
    @media (max-width: 600px) { .pt-readout { gap: 6px 14px; padding: 10px 14px; } }

    .pt-main { max-width: 1140px; margin: 0 auto; padding: 8px 24px 0; }
    .pt-cat { padding: 40px 0; border-bottom: 1px solid var(--color-border); }
    .pt-cat-head { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
    .pt-cat-title { font-size: 18px; font-weight: 600; letter-spacing: -0.02em; color: var(--color-text); }
    .pt-cat-count { margin-left: auto; font-family: 'JetBrains Mono', monospace; font-size: 11.5px; color: var(--color-text-dim);
      border: 1px solid var(--color-border); border-radius: 999px; padding: 4px 11px; }
    .pt-cat-rule { flex: 1; height: 1px; background: var(--color-border); }

    .pt-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
    .pt-tool { display: flex; gap: 14px; align-items: flex-start; text-decoration: none; color: inherit;
      background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 12px; padding: 16px; min-height: 44px;
      transition: background .15s, border-color .15s, transform .15s; }
    .pt-tool .ico { width: 38px; height: 38px; border-radius: 9px; flex: none; display: grid; place-items: center;
      background: var(--color-surface2); color: var(--color-text-muted); border: 1px solid var(--color-border);
      font-family: 'JetBrains Mono', monospace; font-weight: 600; font-size: 13px; transition: background .15s, color .15s, border-color .15s; }
    .pt-tool .nm { font-size: 14.5px; font-weight: 600; letter-spacing: -0.01em; color: var(--color-text); }
    .pt-tool .dsc { font-size: 12.5px; color: var(--color-text-muted); margin-top: 3px; line-height: 1.4; }
    .pt-tool:hover { background: var(--color-surface2); border-color: var(--color-border2); transform: translateY(-2px); }
    .pt-tool:hover .ico { background: var(--color-accent-dim); color: var(--color-accent-fg); border-color: var(--color-accent-edge); }

    /* Featured group (Network) — leads the page with larger stacked cards */
    /* Soft glow fading to transparent on all sides (peak below the top edge) —
       avoids the hard "starts abruptly at the corner" edge of the old 0% 0% radial. */
    .pt-cat.featured { background: radial-gradient(62% 66% at 50% 46%, var(--color-accent-dim), transparent 64%); }
    .pt-cat.featured .pt-tool { flex-direction: column; gap: 14px; padding: 20px; }
    .pt-cat.featured .pt-tool .ico { width: 44px; height: 44px; background: var(--color-accent-dim);
      color: var(--color-accent-fg); border-color: var(--color-accent-edge); }
    .pt-cat.featured .pt-tool .nm { font-size: 16px; }

    .pt-noresults { text-align: center; color: var(--color-text-muted); font-size: 14px; padding: 48px 0; }
    @media (max-width: 920px) { .pt-grid, .pt-cat.featured .pt-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px) { .pt-grid, .pt-cat.featured .pt-grid { grid-template-columns: 1fr; }
      .pt-cat.featured .pt-tool { flex-direction: row; } }
  </style>

  <!-- Theme init (prevent flash) -->
  <script is:inline>
    (function() { try { if (localStorage.getItem('pingthat-theme') === 'light') document.documentElement.classList.add('light'); } catch (e) {} })();
  </script>
</head>
<body>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:rounded focus:text-sm focus:font-medium" style="background: var(--color-accent); color: var(--color-accent-ink);">Skip to content</a>

  <!-- Sticky topbar — brand (our signal-bars logo) + section nav + privacy badge + lang -->
  <div class="pt-topbar">
    <div class="pt-topbar-inner">
      <a class="pt-brand" href="#top" aria-label="PingThat — home">
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <rect fill="currentColor" x="2" y="4" width="3" height="3" rx="0.5" opacity="0.15"/><rect fill="currentColor" x="2" y="9" width="3" height="3" rx="0.5" opacity="0.3"/><rect fill="currentColor" x="2" y="14" width="3" height="3" rx="0.5" opacity="0.55"/><rect fill="currentColor" x="2" y="19" width="3" height="3" rx="0.5" opacity="0.8"/><rect fill="currentColor" x="2" y="24" width="3" height="3" rx="0.5" opacity="1"/>
          <rect fill="currentColor" x="8" y="1" width="3" height="3" rx="0.5" opacity="0.1"/><rect fill="currentColor" x="8" y="6" width="3" height="3" rx="0.5" opacity="0.2"/><rect fill="currentColor" x="8" y="11" width="3" height="3" rx="0.5" opacity="0.35"/><rect fill="currentColor" x="8" y="16" width="3" height="3" rx="0.5" opacity="0.55"/><rect fill="currentColor" x="8" y="21" width="3" height="3" rx="0.5" opacity="0.8"/><rect fill="currentColor" x="8" y="26" width="3" height="3" rx="0.5" opacity="1"/>
          <rect fill="currentColor" x="14" y="8" width="3" height="3" rx="0.5" opacity="0.2"/><rect fill="currentColor" x="14" y="13" width="3" height="3" rx="0.5" opacity="0.4"/><rect fill="currentColor" x="14" y="18" width="3" height="3" rx="0.5" opacity="0.7"/><rect fill="currentColor" x="14" y="23" width="3" height="3" rx="0.5" opacity="1"/>
          <rect fill="currentColor" x="20" y="3" width="3" height="3" rx="0.5" opacity="0.1"/><rect fill="currentColor" x="20" y="8" width="3" height="3" rx="0.5" opacity="0.2"/><rect fill="currentColor" x="20" y="13" width="3" height="3" rx="0.5" opacity="0.4"/><rect fill="currentColor" x="20" y="18" width="3" height="3" rx="0.5" opacity="0.6"/><rect fill="currentColor" x="20" y="23" width="3" height="3" rx="0.5" opacity="0.85"/><rect fill="currentColor" x="20" y="28" width="3" height="3" rx="0.5" opacity="1"/>
          <rect fill="currentColor" x="27" y="6" width="3" height="3" rx="0.5" opacity="0.2"/><rect fill="currentColor" x="27" y="11" width="3" height="3" rx="0.5" opacity="0.45"/><rect fill="currentColor" x="27" y="16" width="3" height="3" rx="0.5" opacity="0.7"/><rect fill="currentColor" x="27" y="21" width="3" height="3" rx="0.5" opacity="1"/>
        </svg>
        <span class="pt-brand-name">PingThat</span>
      </a>
      <nav class="pt-nav cats" aria-label="Tool categories">
        {groups.map((group) => (
          <a href={`#${GROUP_SLUG[group.label] ?? group.label}`}>{group.label}</a>
        ))}
      </nav>
      <a class="pt-nav" href="/docs/" style="margin-right: 2px;">Guides</a>
      <span class="pt-badge"><span class="dot"></span>{c.noDataCollectedPrivate}</span>
      <LangToggle lang="en" enPath="/" esPath="/es/" />
    </div>
  </div>

  <!-- Hero -->
  <header class="pt-hero" id="top">
    <div class="pt-hero-inner" id="main-content" tabindex="-1">
      <p class="pt-eyebrow"><span class="dot"></span><b>{tools.length} {c.heroEyebrow}</b></p>
      <h1 class="pt-h1">{c.heroHeadingPrefix}<em>{c.heroHeadingEm}</em></h1>
      <p class="pt-value">{c.heroText}</p>

      <div class="pt-search">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.5"/><path d="M14 14l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        <input id="home-search" type="search" placeholder={`Search ${tools.length} tools — DNS, SSL, HTTP headers, JWT, subnet...`} aria-label="Search tools" autocomplete="off" />
        <span class="pt-kbd">/</span>
      </div>

      <div class="pt-pills" id="pill-row">
        <span class="pt-pill-lead">Popular</span>
        {pills.map((tool) => (
          <a class="pt-pill" href={tool!.path}><span class="ico" aria-hidden="true">{tool!.icon}</span>{tool!.name}</a>
        ))}
      </div>

      <!-- Live readout (stage-3 hero). Hidden until /cdn-cgi/trace resolves:
           progressive enhancement — on preview/local or fetch failure the hero
           stays exactly as before. Same-origin only; no third party learns the
           visitor's IP (the /my-ip tool with its external geo APIs stays
           opt-in behind a click). -->
      <dl class="pt-readout" id="live-readout" hidden>
        <span class="pt-ro-lead"><span class="dot" aria-hidden="true"></span>{c.readoutLive}</span>
        <div class="pt-ro-item"><dt>{c.readoutIp}</dt><dd id="ro-ip">—</dd></div>
        <div class="pt-ro-item"><dt>{c.readoutCountry}</dt><dd id="ro-loc">—</dd></div>
        <div class="pt-ro-item"><dt>{c.readoutEdge}</dt><dd id="ro-colo">—</dd></div>
        <div class="pt-ro-item"><dt>{c.readoutTls}</dt><dd id="ro-tls">—</dd></div>
        <a class="pt-ro-link" href="/my-ip/">{c.readoutDetail} →</a>
      </dl>
    </div>
  </header>

  <!-- Tool grid -->
  <main class="pt-main">
    <p id="home-no-results" class="pt-noresults hidden">No tools match your search.</p>
    {groups.map((group) => {
      const isFeatured = group.label === "Network";
      return (
        <section class:list={["pt-cat", "home-group", isFeatured && "featured"]} id={GROUP_SLUG[group.label] ?? group.label}>
          <div class="pt-cat-head">
            <h2 class="pt-cat-title">{group.label}</h2>
            <span class="pt-cat-count" data-count>{group.ids.length}</span>
            <span class="pt-cat-rule" aria-hidden="true"></span>
          </div>
          <div class="pt-grid">
            {group.ids.map((id) => {
              const tool = tools.find(t => t.id === id);
              if (!tool) return null;
              const searchText = [tool.name, tool.description, tool.id, ...(tool.keywords || [])].join(' ').toLowerCase();
              return (
                <a href={tool.path} class="pt-tool home-tool-card" data-tool-search={searchText}>
                  <span class="ico" aria-hidden="true">{tool.icon}</span>
                  <span style="min-width: 0;">
                    <span class="nm" style="display: block;">{tool.name}</span>
                    <span class="dsc" style="display: block;">{tool.description}</span>
                  </span>
                </a>
              );
            })}
          </div>
        </section>
      );
    })}

    <!-- Bottom CTA -->
    <div class="text-center py-12">
      <p class="text-[10px] uppercase tracking-[0.15em] mb-3" style="color: var(--color-text-dim);">{c.bottomCtaLabel}</p>
      <p class="text-xs" style="color: var(--color-text-muted);">{c.bottomCtaText}</p>
    </div>
    <CrossLinks exclude="PingThat" lang="en" />
  </main>

  <!-- Footer -->
  <footer class="px-6 py-4 border-t border-[var(--color-border)] text-[11px]" style="color: var(--color-text-dim);">
    <div class="flex justify-between items-center mb-2 gap-3 flex-wrap" style="max-width: 1140px; margin-inline: auto;">
      <span>{c.footerTagline}</span>
      <span class="flex items-center gap-2 flex-wrap">
        <a href="/about/" class="hover:text-[var(--color-accent-fg)] transition-colors">About</a>
        <span style="color: var(--color-border2);">·</span>
        <a href="/contact/" class="hover:text-[var(--color-accent-fg)] transition-colors">Contact</a>
        <span style="color: var(--color-border2);">·</span>
        <a href="/privacy/" class="hover:text-[var(--color-accent-fg)] transition-colors">{c.footerPrivacy}</a>
        <span style="color: var(--color-border2);">·</span>
        <a href="/terms/" class="hover:text-[var(--color-accent-fg)] transition-colors">Terms</a>
        <span style="color: var(--color-border2);">·</span>
        <a href="/methodology/" class="hover:text-[var(--color-accent-fg)] transition-colors">{c.footerMethodology}</a>
        <span style="color: var(--color-border2);">·</span>
        <a href="/docs/" class="hover:text-[var(--color-accent-fg)] transition-colors">Guides</a>
        <span style="color: var(--color-border2);">·</span>
        <a href="https://buymeacoffee.com/allopen" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-accent-fg)] transition-colors">Buy me a coffee</a>
      </span>
    </div>
    <!-- Identity strip — Stanford Web Credibility (T-02/T-04/T-06). -->
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-2" style="color: var(--color-text-muted); font-size: 11px; max-width: 1140px; margin-inline: auto;">
      <span>{c.footerMaintainedBy} · <span style="color: var(--color-text-dim);">{c.footerSince}</span></span>
      <span style="color: var(--color-border2);">·</span>
      <a href={`mailto:${c.footerSupportEmail}?subject=${encodeURIComponent('PingThat — support')}`}
         class="hover:text-[var(--color-accent-fg)] transition-colors inline-block py-1"
         title={c.footerSupportEmailSub}>{c.footerSupportEmail}</a>
      <span style="color: var(--color-border2);">·</span>
      <span style="color: var(--color-text-dim);">{lastVerifiedFooter}</span>
    </div>
    <form id="feedback-form" action="https://formspree.io/f/mpqoddwl" method="POST" class="flex gap-2" style="max-width: 1140px; margin-inline: auto;">
      <input type="hidden" name="app" value="PingThat" />
      <input type="hidden" name="page" value="" />
      <input type="hidden" name="_subject" value="" />
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
      <input type="text" name="message" placeholder="Bug, idea, or feedback..." required
        aria-label="Bug, idea, or feedback..."
        class="flex-1 px-3 py-1.5 rounded text-[11px]"
        style="background: var(--color-surface2); border: 1px solid var(--color-border); color: var(--color-text); font-family: 'Geist', sans-serif;"
      />
      <button type="submit" class="px-3 py-1.5 rounded text-[10px] uppercase tracking-wider"
        style="background: var(--color-surface2); border: 1px solid var(--color-border); color: var(--color-text-muted); cursor: pointer;">
        Send
      </button>
    </form>
  </footer>

  <CookieConsent lang="en" />
  <CmdkPalette lang="en" />

  <!-- Feedback form: AJAX submit + toast (Nielsen audit code-review 2026-04-30). -->
  <script>
    (function () {
      const form = document.getElementById('feedback-form');
      if (!(form instanceof HTMLFormElement)) return;
      const isEs = document.documentElement.lang === 'es';
      const MSG = {
        success: isEs ? '¡Gracias por tu feedback!' : 'Thanks for your feedback!',
        error: isEs ? 'Error al enviar. Inténtalo más tarde.' : 'Error sending. Please try again later.',
      };
      function showToast(text: string, isError: boolean) {
        const toast = document.createElement('div');
        toast.setAttribute('role', 'status');
        toast.setAttribute('aria-live', 'polite');
        toast.textContent = text;
        Object.assign(toast.style, {
          position: 'fixed', bottom: '24px', left: '50%',
          transform: 'translate(-50%, 20px)', padding: '12px 20px',
          borderRadius: '8px', background: isError ? '#dc2626' : '#059669',
          color: '#fff', fontSize: '13px', fontWeight: '500', zIndex: '9999',
          boxShadow: '0 10px 30px rgba(0,0,0,0.35)', opacity: '0',
          transition: 'opacity .25s ease, transform .25s ease',
          cursor: 'pointer', maxWidth: '90vw',
        });
        toast.title = isEs ? 'Clic para cerrar' : 'Click to dismiss';
        document.body.appendChild(toast);
        requestAnimationFrame(() => {
          toast.style.opacity = '1';
          toast.style.transform = 'translate(-50%, 0)';
        });
        let dismissed = false;
        const dismiss = () => {
          if (dismissed) return;
          dismissed = true;
          toast.style.opacity = '0';
          toast.style.transform = 'translate(-50%, 20px)';
          setTimeout(() => toast.remove(), 300);
        };
        toast.addEventListener('click', dismiss);
        setTimeout(dismiss, 5000);
      }
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = form.querySelector('button[type="submit"]');
        const data = new FormData(form);
        data.set('page', location.href);
        const appName = String(data.get('app') || 'PingThat');
        data.set('_subject', `[${appName}] ${location.pathname}`);
        if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;
        try {
          const res = await fetch(form.action, {
            method: 'POST', body: data,
            headers: { Accept: 'application/json' },
          });
          if (res.ok) { showToast(MSG.success, false); form.reset(); }
          else { showToast(MSG.error, true); }
        } catch {
          showToast(MSG.error, true);
        } finally {
          if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
        }
      });
    })();
  </script>

  <!-- Live readout: same-origin CF trace (<100ms, see Layout geo-gate). The
       strip stays hidden unless we got at least an IP — no skeleton flash,
       no degraded state on non-CF environments. -->
  <script>
    fetch('/cdn-cgi/trace')
      .then((r) => r.text())
      .then((t) => {
        const get = (k: string) => (t.match(new RegExp('^' + k + '=(.+)$', 'm')) || [])[1] || '';
        const ip = get('ip');
        if (!ip) return;
        const set = (id: string, v: string) => {
          const el = document.getElementById(id);
          if (el && v) el.textContent = v;
        };
        set('ro-ip', ip);
        set('ro-loc', get('loc'));
        set('ro-colo', get('colo'));
        set('ro-tls', get('tls'));
        const strip = document.getElementById('live-readout');
        if (strip) strip.hidden = false;
      })
      .catch(() => {});
  </script>

  <!-- Hero search filter (Nielsen audit PT F8). Filters .home-tool-card by
       data-tool-search; hides empty .home-group sections + the pill row;
       updates per-category counts. -->
  <script>
    const heroInput = document.getElementById('home-search') as HTMLInputElement | null;
    const heroNoResults = document.getElementById('home-no-results');
    const pillRow = document.getElementById('pill-row');
    if (heroInput) {
      const apply = () => {
        const q = heroInput.value.toLowerCase().trim();
        let anyMatch = false;
        if (pillRow) pillRow.style.display = q ? 'none' : '';
        document.querySelectorAll<HTMLElement>('.home-tool-card').forEach((el) => {
          const text = el.dataset.toolSearch || '';
          const match = !q || text.includes(q);
          el.style.display = match ? '' : 'none';
          if (match) anyMatch = true;
        });
        document.querySelectorAll<HTMLElement>('.home-group').forEach((section) => {
          const cards = Array.from(section.querySelectorAll<HTMLElement>('.home-tool-card'));
          const visibleCards = cards.filter((card) => card.style.display !== 'none');
          section.style.display = visibleCards.length ? '' : 'none';
          const badge = section.querySelector<HTMLElement>('[data-count]');
          if (badge) badge.textContent = String(q ? visibleCards.length : cards.length);
        });
        if (heroNoResults) heroNoResults.classList.toggle('hidden', !q || anyMatch);
      };
      heroInput.addEventListener('input', apply);
      heroInput.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && heroInput.value) { heroInput.value = ''; apply(); }
      });
      document.addEventListener('keydown', (e) => {
        const ae = document.activeElement as HTMLElement | null;
        const typing = ae && ['INPUT', 'TEXTAREA'].includes(ae.tagName);
        if (e.key === '/' && !typing) { e.preventDefault(); heroInput.focus(); }
      });
    }
  </script>
</body>
