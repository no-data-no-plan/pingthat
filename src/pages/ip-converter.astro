---
import Layout from "../layouts/Layout.astro";
import IpConverter from "../components/IpConverter.svelte";
import SeoContent from "../components/SeoContent.astro";
import SeoBlock from "../components/SeoBlock.astro";
import { pageI18n } from "../i18n/pages";

const p = pageI18n["ip-converter"].en;
---

<Layout
  title={p.title}
  description={p.description}
  activeToolId="ip-converter"
>
  <IpConverter client:load />

  <SeoContent
    heading={p.seoHeading}
    text={p.seoText}
    relatedToolIds={["subnet-calculator", "my-ip", "password-strength"]}
  />

  <SeoBlock
    heading={p.seoBlockHeading}
    text={p.seoBlockText}
    features={p.seoFeatures}
  />
</Layout>
