---
import Layout from "../layouts/Layout.astro";
import RedirectChecker from "../components/RedirectChecker.svelte";
import SeoContent from "../components/SeoContent.astro";
import SeoBlock from "../components/SeoBlock.astro";
import { pageI18n } from "../i18n/pages";

const p = pageI18n["redirect-checker"].en;
---

<Layout
  title={p.title}
  description={p.description}
  activeToolId="redirect-checker"
>
  <RedirectChecker client:only="svelte" />

  <SeoContent
    heading={p.seoHeading}
    text={p.seoText}
    relatedToolIds={["http-headers", "ssl-checker", "is-it-down"]}
  />

  <SeoBlock
    heading={p.seoBlockHeading}
    text={p.seoBlockText}
    features={p.seoFeatures}
  />
</Layout>
