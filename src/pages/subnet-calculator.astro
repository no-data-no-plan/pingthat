---
import Layout from "../layouts/Layout.astro";
import SubnetCalculator from "../components/SubnetCalculator.svelte";
import SeoContent from "../components/SeoContent.astro";
import SeoBlock from "../components/SeoBlock.astro";
import ToolContent from "../components/ToolContent.astro";
import { pageI18n } from "../i18n/pages";

const p = pageI18n["subnet-calculator"].en;
---

<Layout
  title={p.title}
  description={p.description}
  activeToolId="subnet-calculator"
>
  <SubnetCalculator client:load />

  <SeoContent
    heading={p.seoHeading}
    text={p.seoText}
    relatedToolIds={["ip-converter", "my-ip", "jwt-decoder"]}
  />

  <ToolContent
    howHeading={p.howHeading}
    howSteps={p.howSteps}
    useCasesHeading={p.useCasesHeading}
    useCases={p.useCases}
    faqHeading={p.faqHeading}
    faqs={p.faqs}
  />

    <SeoBlock
    heading={p.seoBlockHeading}
    text={p.seoBlockText}
    features={p.seoFeatures}
  />
</Layout>
