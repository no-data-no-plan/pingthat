---
import "../styles/global.css";
import { tools } from "../lib/tools";

const popularIds = [
  "my-ip",
  "privacy-check",
  "webrtc-leak-test",
  "dns-lookup",
  "ssl-checker",
  "subnet-calculator",
  "jwt-decoder",
  "password-strength",
];
const popular = popularIds.map(id => tools.find(t => t.id === id)).filter(Boolean);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>Page Not Found — PingThat</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Fonts (self-hosted) -->
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
  <style>
    html[lang="es"] [data-lang="en"] { display: none !important; }
    html:not([lang="es"]) [data-lang="es"] { display: none !important; }
  </style>
  <script is:inline>
    (function() {
      if (localStorage.getItem('pingthat-theme') === 'light') {
        document.documentElement.classList.add('light');
      }
      var isEs = location.pathname === '/es' || location.pathname.indexOf('/es/') === 0;
      if (isEs) {
        document.documentElement.lang = 'es';
        document.title = 'Página no encontrada — PingThat';
      }
    })();
  </script>
</head>
<body style="background: var(--color-bg); color: var(--color-text);">
  <div class="min-h-screen flex flex-col items-center justify-center px-6 py-12">
    <div class="text-center max-w-2xl">
      <p class="text-6xl font-bold mb-4" style="color: var(--color-accent);">404</p>

      <div data-lang="en">
        <h1 class="text-xl font-semibold mb-2" style="color: var(--color-text);">Page not found</h1>
        <p class="text-sm mb-6" style="color: var(--color-text-muted);">
          The page you're looking for doesn't exist or has been moved. Here are some popular tools instead:
        </p>
      </div>
      <div data-lang="es">
        <h1 class="text-xl font-semibold mb-2" style="color: var(--color-text);">Página no encontrada</h1>
        <p class="text-sm mb-6" style="color: var(--color-text-muted);">
          La página que buscas no existe o ha sido movida. Aquí tienes algunas herramientas populares:
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-8">
        {popular.map((t) => (
          <>
            <a data-lang="en" href={t!.path} class="px-3 py-2 rounded text-xs font-medium transition-colors"
               style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text);">
              {t!.name}
            </a>
            <a data-lang="es" href={`/es${t!.path}`} class="px-3 py-2 rounded text-xs font-medium transition-colors"
               style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text);">
              {t!.name}
            </a>
          </>
        ))}
      </div>

      <a data-lang="en" href="/" class="inline-block px-4 py-2 rounded text-sm font-medium transition-colors" style="background: var(--color-accent); color: #fff;">
        Browse all tools
      </a>
      <a data-lang="es" href="/es" class="inline-block px-4 py-2 rounded text-sm font-medium transition-colors" style="background: var(--color-accent); color: #fff;">
        Ver todas las herramientas
      </a>
    </div>
  </div>
</body>
</html>
