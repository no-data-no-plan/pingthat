---
import LangToggle from "../components/LangToggle.astro";
import "../styles/global.css";
import { tools } from "../lib/tools";

const popularIds = [
  "my-ip",
  "privacy-check",
  "webrtc-leak-test",
  "dns-lookup",
  "ssl-checker",
  "subnet-calculator",
  "jwt-decoder",
  "password-strength",
];
const popular = popularIds.map(id => tools.find(t => t.id === id)).filter(Boolean);
import fs from "node:fs";
import path from "node:path";
const FONTS_CSS = fs.readFileSync(path.resolve("public/fonts/fonts.css"), "utf-8");
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>Page Not Found — PingThat</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Fonts (self-hosted). latin-ext loaded on-demand via fonts.css unicode-range. -->
  <style is:inline set:html={FONTS_CSS}></style>
  <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Google Analytics 4 — Consent Mode v2. AdSense intentionally excluded: Google
       program policies prohibit serving ads on 404 pages. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    // [PW-GUARD-V1] Skip GA4 init when running under browser automation
    // (Playwright, Selenium, Puppeteer). Diagnosed 2026-05-20: 6047 fake
    // "real" PV on CV /pro/ Apr 22-25 were our own Playwright e2e tests,
    // geoIP'd to "Parla" (Madrid POP). gtag() stays defined as no-op so
    // other call sites (tool-complete.svelte.ts etc.) don't crash.
    if (!(window.__PW_TEST__ || navigator.webdriver)) {
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500,
    });
      // [GEO-GATE-V1] analytics_storage stays denied for EU/EEA/UK; granted elsewhere.
      // Fires inside wait_for_update window (500ms) so non-EU pings still flow.
      // CF /cdn-cgi/trace responds <100ms — well within the budget.
      fetch("/cdn-cgi/trace").then(function(r){return r.text();}).then(function(t){
        var m = t.match(/loc=([A-Z]{2})/);
        var cc = m ? m[1] : "";
        var EU = ["AT","BE","BG","CY","CZ","DE","DK","EE","ES","FI","FR","GR","HR","HU","IE","IT","LT","LU","LV","MT","NL","PL","PT","RO","SE","SI","SK","GB","UK","IS","LI","NO","CH"];
        if (cc && EU.indexOf(cc) === -1) {
          gtag("consent","update",{analytics_storage:"granted"});
        }
      }).catch(function(){});
    gtag('js', new Date());
    gtag('config', 'G-MRBSLR79JG', { anonymize_ip: true });
    var _s=document.createElement('script');_s.async=true;_s.src='https://www.googletagmanager.com/gtag/js?id=G-MRBSLR79JG';document.head.appendChild(_s);
    }
  </script>

  <script is:inline>
    // CRITICAL: this script must run BEFORE the <style> block defining the
    // CSS locale gate. The browser parses HTML top-to-bottom: if the gate
    // were defined first, CSSOM would resolve with lang="en" and BOTH
    // [data-lang] spans paint, then the lang flips and CSSOM recalculates —
    // exactly the "EN ES EN ES" flash we are preventing. Round-2 cross-
    // portfolio review fix 2026-04-30 (matches AY 404.astro).
    (function() {
      if (localStorage.getItem('pingthat-theme') === 'light') {
        document.documentElement.classList.add('light');
      }
      var isEs = location.pathname === '/es' || location.pathname.indexOf('/es/') === 0;
      if (isEs) {
        document.documentElement.lang = 'es';
        document.title = 'Página no encontrada — PingThat';
      }
    })();
  </script>
  <style>
    html[lang="es"] [data-lang="en"] { display: none !important; }
    html:not([lang="es"]) [data-lang="es"] { display: none !important; }
  </style>
</head>
<body style="background: var(--color-bg); color: var(--color-text);">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:rounded focus:text-sm focus:font-medium" style="background: var(--color-accent); color: var(--color-bg);">
    <span data-lang="en">Skip to content</span>
    <span data-lang="es">Saltar al contenido</span>
  </a>
  <div class="absolute top-4 right-4 z-30">
    <span data-lang="en"><LangToggle lang="en" enPath="/" esPath="/es/" /></span>
    <span data-lang="es"><LangToggle lang="es" enPath="/" esPath="/es/" /></span>
  </div>
  <main id="main-content" tabindex="-1" class="min-h-screen flex flex-col items-center justify-center px-6 py-12">
    <div class="text-center max-w-2xl">
      <p class="text-6xl font-bold mb-4" style="color: var(--color-accent-fg);">404</p>

      <div data-lang="en">
        <h1 class="text-xl font-semibold mb-2" style="color: var(--color-text);">Page not found</h1>
        <p class="text-sm mb-6" style="color: var(--color-text-muted);">
          The page you're looking for doesn't exist or has been moved. Here are some popular tools instead:
        </p>
      </div>
      <div data-lang="es">
        <h1 class="text-xl font-semibold mb-2" style="color: var(--color-text);">Página no encontrada</h1>
        <p class="text-sm mb-6" style="color: var(--color-text-muted);">
          La página que buscas no existe o ha sido movida. Aquí tienes algunas herramientas populares:
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-8">
        {popular.map((t) => (
          <>
            <a data-lang="en" href={t!.path} class="px-3 py-2 rounded text-xs font-medium transition-colors"
               style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text);">
              {t!.name}
            </a>
            <a data-lang="es" href={`/es${t!.path}`} class="px-3 py-2 rounded text-xs font-medium transition-colors"
               style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text);">
              {t!.name}
            </a>
          </>
        ))}
      </div>

      <a data-lang="en" href="/" class="inline-block px-4 py-2 rounded text-sm font-medium transition-colors" style="background: var(--color-accent); color: #fff;">
        Browse all tools
      </a>
      <a data-lang="es" href="/es/" class="inline-block px-4 py-2 rounded text-sm font-medium transition-colors" style="background: var(--color-accent); color: #fff;">
        Ver todas las herramientas
      </a>
    </div>
  </main>

  <!-- Recovery footer (Nielsen audit 2026-04-30, PT F2 + F17): give 404 users
       legal/about/contact/buy-me-a-coffee links — currently /about/ is only
       reachable from tool-page footers, which the 404 used to lack. -->
  <footer class="px-4 py-3 border-t text-xs flex items-center justify-center gap-4 flex-wrap" style="border-color: var(--color-border); color: var(--color-text-muted);">
    <a data-lang="en" href="/about/" class="underline hover:no-underline">About</a>
    <a data-lang="es" href="/es/about/" class="underline hover:no-underline">Acerca de</a>
    <a data-lang="en" href="/privacy/" class="underline hover:no-underline">Privacy</a>
    <a data-lang="es" href="/es/privacy/" class="underline hover:no-underline">Privacidad</a>
    <a data-lang="en" href="/docs/" class="underline hover:no-underline">Guides</a>
    <a data-lang="es" href="/es/docs/" class="underline hover:no-underline">Guías</a>
    <a href="https://buymeacoffee.com/allopen" target="_blank" rel="noopener noreferrer" class="underline hover:no-underline">Buy me a coffee</a>
  </footer>
</body>
</html>
