---
import Layout from "../../layouts/Layout.astro";
import IpConverter from "../../components/IpConverter.svelte";
import SeoContent from "../../components/SeoContent.astro";
import SeoBlock from "../../components/SeoBlock.astro";
import { pageI18n } from "../../i18n/pages";

const p = pageI18n["ip-converter"].es;
---

<Layout
  title={p.title}
  description={p.description}
  activeToolId="ip-converter"
  lang="es"
>
  <IpConverter client:load lang="es" />

  <SeoContent
    heading={p.seoHeading}
    text={p.seoText}
    relatedToolIds={["subnet-calculator", "my-ip"]}
    lang="es"
  />

  <SeoBlock
    heading={p.seoBlockHeading}
    text={p.seoBlockText}
    features={p.seoFeatures}
    lang="es"
  />
</Layout>
