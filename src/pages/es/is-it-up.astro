---
import Layout from "../../layouts/Layout.astro";
import IsItUp from "../../components/IsItUp.svelte";
import SeoContent from "../../components/SeoContent.astro";
import SeoBlock from "../../components/SeoBlock.astro";
import { pageI18n } from "../../i18n/pages";
const p = pageI18n["is-it-up"].es;
---
<Layout title={p.title} description={p.description} activeToolId="is-it-up" lang="es">
  <IsItUp client:only="svelte" lang="es" />
  <SeoContent heading={p.seoHeading} text={p.seoText} relatedToolIds={["is-it-down", "http-headers", "ssl-checker"]} lang="es" />
  <SeoBlock heading={p.seoBlockHeading} text={p.seoBlockText} features={p.seoFeatures} lang="es" />
</Layout>
