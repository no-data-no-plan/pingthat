---
import Layout from "../../layouts/Layout.astro";
import RedirectChecker from "../../components/RedirectChecker.svelte";
import SeoContent from "../../components/SeoContent.astro";
import SeoBlock from "../../components/SeoBlock.astro";
import { pageI18n } from "../../i18n/pages";
const p = pageI18n["redirect-checker"].es;
---
<Layout title={p.title} description={p.description} activeToolId="redirect-checker" lang="es">
  <RedirectChecker client:only="svelte" lang="es" />
  <SeoContent heading={p.seoHeading} text={p.seoText} relatedToolIds={["http-headers", "ssl-checker", "is-it-down"]} lang="es" />
  <SeoBlock heading={p.seoBlockHeading} text={p.seoBlockText} features={p.seoFeatures} lang="es" />
</Layout>
