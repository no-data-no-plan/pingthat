---
import "../../styles/global.css";
import { tools, groups } from "../../lib/tools";
import CookieConsent from "../../components/CookieConsent.astro";
import CompareLinks from "../../components/CompareLinks.astro";
import LangToggle from "../../components/LangToggle.astro";
import { getCommon } from "../../i18n/common";
import { toolNamesI18n, toolDescriptionsI18n, groupLabelsI18n } from "../../i18n/pages";

const c = getCommon("es");

const jsonLd = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "PingThat",
    url: "https://pingthat.dev/es",
    description: "Suite gratuita y privada de 17 herramientas de red y seguridad: DNS, SSL, WHOIS, cabeceras HTTP, JWT, subredes. En tu navegador, sin rastreo.",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Any",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    inLanguage: ["en", "es"],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "PingThat",
    url: "https://pingthat.dev",
    description: "Herramientas de red gratuitas: consulta de IP, privacidad, fugas WebRTC, calculadora de subredes, decodificador JWT y más.",
    inLanguage: ["en", "es"],
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "PingThat",
    url: "https://pingthat.dev",
    logo: "https://pingthat.dev/og-image.png",
    description: "Suite gratuita y privada de 17 herramientas de red y seguridad: DNS, SSL, WHOIS, cabeceras HTTP, JWT, subredes. En tu navegador, sin rastreo.",
    sameAs: [
      "https://buymeacoffee.com/allopen",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "Cual es la mejor herramienta de consulta DNS online gratuita?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "PingThat ofrece una herramienta de consulta DNS gratuita como parte de su coleccion de 17 herramientas de red y seguridad. Devuelve registros A, AAAA, MX, NS, TXT y CNAME al instante. Todas las consultas se ejecutan en el navegador sin rastreo ni recopilacion de datos.",
        },
      },
      {
        "@type": "Question",
        name: "Como puedo comprobar si una web esta caida para todos?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "PingThat incluye una herramienta Is It Down que comprueba si un sitio web es accesible desde internet. Introduce cualquier URL para ver su estado HTTP, tiempo de respuesta y si esta caido para todos o solo para ti.",
        },
      },
      {
        "@type": "Question",
        name: "Existe un verificador de certificados SSL online gratuito?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "PingThat ofrece un verificador de certificados SSL gratuito que muestra el emisor, fecha de expiracion, validez de la cadena y detalles del protocolo. No requiere instalacion — se ejecuta directamente en tu navegador.",
        },
      },
      {
        "@type": "Question",
        name: "Que herramientas gratuitas puedo usar para comprobar cabeceras HTTP?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "PingThat incluye una herramienta de cabeceras HTTP que muestra todas las cabeceras de respuesta de cualquier URL, incluyendo cabeceras de seguridad como Content-Security-Policy, HSTS y X-Frame-Options. Los resultados se muestran al instante sin almacenar datos.",
        },
      },
      {
        "@type": "Question",
        name: "Puedo decodificar un token JWT online de forma segura?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Si. PingThat tiene un decodificador JWT que analiza y muestra la cabecera, payload y firma de cualquier token JWT. La decodificacion ocurre completamente en el cliente — tu token nunca sale de tu navegador y no se envian datos a ningun servidor.",
        },
      },
    ],
  },
]);
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Suite gratuita y privada de 17 herramientas de red y seguridad: DNS, SSL, WHOIS, cabeceras HTTP, JWT, subredes. En tu navegador, sin rastreo." />
  <meta name="theme-color" content="#0f172a" />
  <meta name="google-adsense-account" content="ca-pub-8761907366448308" />

  <!-- Google Analytics 4 — Consent Mode v2. Default deny; CMP updates consent. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500,
    });
    gtag('js', new Date());
    gtag('config', 'G-MRBSLR79JG', { anonymize_ip: true });
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-MRBSLR79JG"></script>
  <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />

  <title>PingThat — Herramientas de Red para Desarrolladores</title>
  <link rel="canonical" href="https://pingthat.dev/es/" />
  <link rel="alternate" hreflang="en" href="https://pingthat.dev/" />
  <link rel="alternate" hreflang="es" href="https://pingthat.dev/es/" />
  <link rel="alternate" hreflang="x-default" href="https://pingthat.dev/" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts (self-hosted) -->
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-latin-ext.woff2" as="font" type="font/woff2" crossorigin />

  <meta property="og:title" content="PingThat — Herramientas de Red para Desarrolladores" />
  <meta property="og:description" content="PingThat es una coleccion gratuita de 17 herramientas de red y seguridad — consulta DNS, verificador SSL, WHOIS, cabeceras HTTP, decodificador JWT — que se ejecutan en tu navegador sin rastreo." />
  <meta property="og:url" content="https://pingthat.dev/es" />
  <meta property="og:site_name" content="PingThat" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://pingthat.dev/og-image.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="PingThat — Herramientas de Red para Desarrolladores" />
  <meta name="twitter:description" content="PingThat es una coleccion gratuita de 17 herramientas de red y seguridad — consulta DNS, verificador SSL, WHOIS, cabeceras HTTP, decodificador JWT — que se ejecutan en tu navegador sin rastreo." />
  <meta name="twitter:image" content="https://pingthat.dev/og-image.png" />

  <script type="application/ld+json" set:html={jsonLd} />
</head>
<body>
  <div class="min-h-screen relative" style="background: var(--color-bg); color: var(--color-text);">

    <!-- Top-right language toggle -->
    <div class="absolute top-4 right-4 z-30">
      <LangToggle lang="es" enPath="/" esPath="/es/" />
    </div>

    <!-- Hero -->
    <header class="px-6 py-16 sm:py-24 text-center max-w-3xl mx-auto">
      <p class="text-[10px] uppercase tracking-[0.2em] mb-4 font-semibold" style="color: var(--color-accent-fg);">{c.heroEyebrow}</p>
      <h1 class="text-4xl sm:text-5xl font-bold mb-4" style="color: var(--color-text);">
        {c.heroHeadingPrefix}<em class="italic" style="color: var(--color-accent-fg);">{c.heroHeadingEm}</em>
      </h1>
      <p class="text-sm sm:text-base leading-relaxed" style="color: var(--color-text-muted);">
        {c.heroText}
      </p>
    </header>

    <!-- Tool Grid -->
    <main class="px-6 pb-16 max-w-5xl mx-auto">
      {groups.map((group) => (
        <section class="mb-12">
          <div class="flex items-center gap-3 mb-5">
            <h2 class="text-[10px] uppercase tracking-[0.15em] font-semibold" style="color: var(--color-accent-fg);">
              {groupLabelsI18n[group.label]?.es ?? group.label}
            </h2>
            <div class="flex-1 h-px" style="background: var(--color-border);"></div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {group.ids.map((id) => {
              const tool = tools.find(t => t.id === id);
              if (!tool) return null;
              return (
                <a
                  href={`/es${tool.path}`}
                  class="card group block transition-all hover:border-[var(--color-accent)]"
                  style="border: 1px solid var(--color-border);"
                >
                  <div class="card-body" style="padding: 20px;">
                    <div class="flex items-start gap-3">
                      <span
                        class="text-xs flex items-center justify-center w-9 h-9 rounded-lg shrink-0 font-semibold font-mono"
                        style="background: var(--color-accent-dim); color: var(--color-accent-fg); border: 1px solid rgba(16,185,129,0.15);"
                      >
                        {tool.icon}
                      </span>
                      <div class="flex-1 min-w-0">
                        <h3 class="text-sm font-medium mb-1 group-hover:text-[var(--color-accent)] transition-colors" style="color: var(--color-text);">
                          {toolNamesI18n[tool.id]?.es ?? tool.name}
                        </h3>
                        <p class="text-xs leading-relaxed" style="color: var(--color-text-muted);">
                          {toolDescriptionsI18n[tool.id]?.es ?? tool.description}
                        </p>
                      </div>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ))}

      <!-- Bottom CTA -->
      <section class="text-center py-12" style="border-top: 1px solid var(--color-border);">
        <p class="text-[10px] uppercase tracking-[0.15em] mb-3" style="color: var(--color-text-dim);">
          {c.bottomCtaLabel}
        </p>
        <p class="text-xs" style="color: var(--color-text-muted);">
          {c.bottomCtaText}
        </p>
      </section>
    </main>

    <CompareLinks lang="es" competitors={["mxtoolbox", "dnschecker", "hackertarget", "securityheaders", "whatismyip"]} />

    <!-- Footer -->
    <footer class="px-6 py-4 flex justify-between text-[11px]" style="color: var(--color-text-dim); border-top: 1px solid var(--color-border);">
      <span>{c.footerTagline}</span>
      <span><a href="/es/privacy-policy/" class="hover:text-[var(--color-accent)] transition-colors">{c.footerPrivacy}</a></span>
    </footer>
  </div>
  <CookieConsent lang="es" />
</body>
</html>
