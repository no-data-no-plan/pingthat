---
import "../../styles/global.css";
import { tools, groups } from "../../lib/tools";
import CookieConsent from "../../components/CookieConsent.astro";
import { getCommon } from "../../i18n/common";
import { toolNamesI18n, toolDescriptionsI18n, groupLabelsI18n } from "../../i18n/pages";

const c = getCommon("es");

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "PingThat",
  url: "https://pingthat.dev/es",
  description: "Herramientas de red gratuitas para desarrolladores. Comprueba tu IP, analiza la privacidad, calcula subredes, decodifica JWTs. 100% en el cliente, sin recogida de datos.",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
});
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Herramientas de red gratuitas para desarrolladores. Comprueba tu IP, analiza la privacidad del navegador, detecta fugas WebRTC, calcula subredes, convierte IPs, comprueba la fortaleza de contrase\u00f1as, decodifica JWTs. 100% en el cliente." />
  <meta name="keywords" content="herramientas de red, cual es mi ip, comprobaci\u00f3n de privacidad, test fugas webrtc, calculadora de subredes, conversor de ip, fortaleza de contrase\u00f1as, decodificador jwt, herramientas para desarrolladores" />
  <meta name="theme-color" content="#0f172a" />
  <meta name="google-adsense-account" content="ca-pub-8761907366448308" />

  <title>PingThat — Herramientas de Red para Desarrolladores</title>
  <link rel="canonical" href="https://pingthat.dev/es/" />
  <link rel="alternate" hreflang="en" href="https://pingthat.dev/" />
  <link rel="alternate" hreflang="es" href="https://pingthat.dev/es/" />
  <link rel="alternate" hreflang="x-default" href="https://pingthat.dev/" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <meta property="og:title" content="PingThat — Herramientas de Red para Desarrolladores" />
  <meta property="og:description" content="Herramientas de red gratuitas para desarrolladores. Comprueba tu IP, analiza la privacidad, decodifica JWTs. 100% en el cliente, sin recogida de datos." />
  <meta property="og:url" content="https://pingthat.dev/es" />
  <meta property="og:site_name" content="PingThat" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://pingthat.dev/og-image.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="PingThat — Herramientas de Red para Desarrolladores" />
  <meta name="twitter:description" content="Herramientas de red gratuitas para desarrolladores. Comprueba tu IP, analiza la privacidad, decodifica JWTs. 100% en el cliente, sin recogida de datos." />
  <meta name="twitter:image" content="https://pingthat.dev/og-image.png" />

  <script type="application/ld+json" set:html={jsonLd} />
</head>
<body>
  <div class="min-h-screen" style="background: var(--color-bg); color: var(--color-text);">

    <!-- Hero -->
    <header class="px-6 py-16 sm:py-24 text-center max-w-3xl mx-auto">
      <div class="flex justify-end mb-4">
        <a href="/" class="text-[11px] px-2 py-1 rounded border border-[var(--color-border)] text-[var(--color-text-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] transition-colors" style="text-decoration: none; font-weight: 500;">EN</a>
      </div>
      <p class="text-[10px] uppercase tracking-[0.2em] mb-4 font-semibold" style="color: var(--color-accent);">{c.heroEyebrow}</p>
      <h1 class="text-4xl sm:text-5xl font-bold mb-4" style="color: var(--color-text);">
        {c.heroHeadingPrefix}<em class="italic" style="color: var(--color-accent);">{c.heroHeadingEm}</em>
      </h1>
      <p class="text-sm sm:text-base leading-relaxed" style="color: var(--color-text-muted);">
        {c.heroText}
      </p>
    </header>

    <!-- Tool Grid -->
    <main class="px-6 pb-16 max-w-5xl mx-auto">
      {groups.map((group) => (
        <section class="mb-12">
          <div class="flex items-center gap-3 mb-5">
            <h2 class="text-[10px] uppercase tracking-[0.15em] font-semibold" style="color: var(--color-accent);">
              {groupLabelsI18n[group.label]?.es ?? group.label}
            </h2>
            <div class="flex-1 h-px" style="background: var(--color-border);"></div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {group.ids.map((id) => {
              const tool = tools.find(t => t.id === id);
              if (!tool) return null;
              return (
                <a
                  href={`/es${tool.path}`}
                  class="card group block transition-all hover:border-[var(--color-accent)]"
                  style="border: 1px solid var(--color-border);"
                >
                  <div class="card-body" style="padding: 20px;">
                    <div class="flex items-start gap-3">
                      <span
                        class="text-xs flex items-center justify-center w-9 h-9 rounded-lg shrink-0 font-semibold font-mono"
                        style="background: var(--color-accent-dim); color: var(--color-accent); border: 1px solid rgba(16,185,129,0.15);"
                      >
                        {tool.icon}
                      </span>
                      <div class="flex-1 min-w-0">
                        <h3 class="text-sm font-medium mb-1 group-hover:text-[var(--color-accent)] transition-colors" style="color: var(--color-text);">
                          {toolNamesI18n[tool.id]?.es ?? tool.name}
                        </h3>
                        <p class="text-xs leading-relaxed" style="color: var(--color-text-muted);">
                          {toolDescriptionsI18n[tool.id]?.es ?? tool.description}
                        </p>
                      </div>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ))}

      <!-- Bottom CTA -->
      <section class="text-center py-12" style="border-top: 1px solid var(--color-border);">
        <p class="text-[10px] uppercase tracking-[0.15em] mb-3" style="color: var(--color-text-dim);">
          {c.bottomCtaLabel}
        </p>
        <p class="text-xs" style="color: var(--color-text-muted);">
          {c.bottomCtaText}
        </p>
      </section>
    </main>

    <!-- Footer -->
    <footer class="px-6 py-4 flex justify-between text-[11px]" style="color: var(--color-text-dim); border-top: 1px solid var(--color-border);">
      <span>{c.footerTagline}</span>
      <span><a href="/es/privacy-policy" class="hover:text-[var(--color-accent)] transition-colors">{c.footerPrivacy}</a></span>
    </footer>
  </div>
  <CookieConsent lang="es" />
</body>
</html>
