---
import "../../styles/global.css";
import { tools, groups } from "../../lib/tools";
import CookieConsent from "../../components/CookieConsent.astro";
import CrossLinks from "../../components/CrossLinks.astro";
import LangToggle from "../../components/LangToggle.astro";
import { getCommon } from "../../i18n/common";
import { toolNamesI18n, toolDescriptionsI18n, groupLabelsI18n } from "../../i18n/pages";

const c = getCommon("es");

// Build-time month for "Last verified" footer (Bloque 1b — CI-set, mirrors Layout.astro pattern).
const MONTHS_ES = ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"];
const _bd = new Date();
const monthYear = `${MONTHS_ES[_bd.getMonth()]} ${_bd.getFullYear()}`;
const lastVerifiedFooter = c.footerLastVerified.replace("{{month}}", monthYear);

const jsonLd = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "PingThat",
    url: "https://pingthat.dev/es",
    description: "Suite gratuita de 23 herramientas de red y seguridad: DNS, SSL, WHOIS, cabeceras HTTP, JWT, subredes. En tu navegador o consultando APIs públicas (DoH/RDAP).",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Any",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    inLanguage: ["en", "es"],
    author: { "@type": "Person", name: "Marco B.", url: "https://pingthat.dev/es/about/" },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "PingThat",
    url: "https://pingthat.dev",
    description: "Herramientas de red gratuitas: consulta de IP, privacidad, fugas WebRTC, calculadora de subredes, decodificador JWT y más.",
    inLanguage: ["en", "es"],
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "PingThat",
    url: "https://pingthat.dev",
    logo: "https://pingthat.dev/og-image.png",
    description: "Suite gratuita de 23 herramientas de red y seguridad: DNS, SSL, WHOIS, cabeceras HTTP, JWT, subredes. En tu navegador o consultando APIs públicas (DoH/RDAP).",
    sameAs: [
      "https://buymeacoffee.com/allopen",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "Que hace la herramienta de consulta DNS de PingThat?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "PingThat ofrece una herramienta de consulta DNS gratuita como parte de su coleccion de 23 herramientas de red y seguridad. Devuelve registros A, AAAA, MX, NS, TXT y CNAME al instante. Todas las consultas usan Cloudflare DoH y se ejecutan en el navegador; PingThat no registra el contenido. Ver /methodology/ para el desglose por herramienta.",
        },
      },
      {
        "@type": "Question",
        name: "Como puedo comprobar si una web esta caida para todos?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "PingThat incluye una herramienta Is It Down que comprueba si un sitio web es accesible desde internet. Introduce cualquier URL para ver su estado HTTP, tiempo de respuesta y si esta caido para todos o solo para ti.",
        },
      },
      {
        "@type": "Question",
        name: "Existe un verificador de certificados SSL online gratuito?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "PingThat ofrece un verificador de certificados SSL gratuito que muestra el emisor, fecha de expiracion, validez de la cadena y detalles del protocolo. No requiere instalacion — se ejecuta directamente en tu navegador.",
        },
      },
      {
        "@type": "Question",
        name: "Que herramientas gratuitas puedo usar para comprobar cabeceras HTTP?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "PingThat incluye una herramienta de cabeceras HTTP que muestra todas las cabeceras de respuesta de cualquier URL, incluyendo cabeceras de seguridad como Content-Security-Policy, HSTS y X-Frame-Options. Los resultados se muestran al instante sin almacenar datos.",
        },
      },
      {
        "@type": "Question",
        name: "Puedo decodificar un token JWT online de forma segura?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Si. PingThat tiene un decodificador JWT que analiza y muestra la cabecera, payload y firma de cualquier token JWT. La decodificacion ocurre completamente en el cliente — tu token nunca sale de tu navegador y no se envian datos a ningun servidor.",
        },
      },
    ],
  },
]);
import fs from "node:fs";
import path from "node:path";
const FONTS_CSS = fs.readFileSync(path.resolve("public/fonts/fonts.css"), "utf-8");
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Suite gratuita de 23 herramientas de red y seguridad: DNS, SSL, WHOIS, cabeceras HTTP, JWT, subredes. En tu navegador o consultando APIs públicas (DoH/RDAP)." />
  <meta name="theme-color" content="#0f172a" />
  <meta name="author" content="Marco B." />
  <meta name="google-adsense-account" content="ca-pub-8761907366448308" />

  <!-- Google Analytics 4 — Consent Mode v2. Default deny; CMP updates consent. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    // [PW-GUARD-V1] Skip GA4 init when running under browser automation
    // (Playwright, Selenium, Puppeteer). Diagnosed 2026-05-20: 6047 fake
    // "real" PV on CV /pro/ Apr 22-25 were our own Playwright e2e tests,
    // geoIP'd to "Parla" (Madrid POP). gtag() stays defined as no-op so
    // other call sites (tool-complete.svelte.ts etc.) don't crash.
    if (!(window.__PW_TEST__ || navigator.webdriver)) {
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500,
    });
      // [GEO-GATE-V1] analytics_storage stays denied for EU/EEA/UK; granted elsewhere.
      // Fires inside wait_for_update window (500ms) so non-EU pings still flow.
      // CF /cdn-cgi/trace responds <100ms — well within the budget.
      fetch("/cdn-cgi/trace").then(function(r){return r.text();}).then(function(t){
        var m = t.match(/loc=([A-Z]{2})/);
        var cc = m ? m[1] : "";
        var EU = ["AT","BE","BG","CY","CZ","DE","DK","EE","ES","FI","FR","GR","HR","HU","IE","IT","LT","LU","LV","MT","NL","PL","PT","RO","SE","SI","SK","GB","UK","IS","LI","NO","CH"];
        if (cc && EU.indexOf(cc) === -1) {
          gtag("consent","update",{analytics_storage:"granted"});
        }
      }).catch(function(){});
    gtag('js', new Date());
    gtag('config', 'G-MRBSLR79JG', { anonymize_ip: true });
    var _s=document.createElement('script');_s.async=true;_s.src='https://www.googletagmanager.com/gtag/js?id=G-MRBSLR79JG';document.head.appendChild(_s);
    }
  </script>

  <!-- Preconnect to AdSense origins -->
  <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
  <link rel="preconnect" href="https://fundingchoicesmessages.google.com" crossorigin />
  <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
  <link rel="dns-prefetch" href="https://adservice.google.com" />

  <!-- Google Funding Choices CMP — loads BEFORE AdSense. No UI outside regulated regions. -->
  <script async src="https://fundingchoicesmessages.google.com/i/pub-8761907366448308?ers=1"></script>
  <script is:inline>
    (function() { function signalGooglefcPresent() { if (!window.frames['googlefcPresent']) { if (document.body) { const iframe = document.createElement('iframe'); iframe.style = 'width: 0; height: 0; border: none; z-index: -1000; left: -1000px; top: -1000px;'; iframe.style.display = 'none'; iframe.name = 'googlefcPresent'; document.body.appendChild(iframe); } else { setTimeout(signalGooglefcPresent, 0); } } } signalGooglefcPresent(); })();
  </script>

  <!-- Google AdSense — CMP (above) controls consent per region -->
    <script is:inline>
  // Defer AdSense load until after LCP (idle callback or post-load timeout).
  // Funding Choices CMP loads synchronously above to satisfy GDPR; AdSense
  // can wait. Saves ~100-150ms LCP on mobile (Lighthouse main-thread audit).
  (function () {
    function loadAdSense() {
      var s = document.createElement("script");
      s.async = true;
      s.crossOrigin = "anonymous";
      s.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8761907366448308";
      document.head.appendChild(s);
    }
    if ("requestIdleCallback" in window) {
      requestIdleCallback(loadAdSense, { timeout: 3000 });
    } else {
      window.addEventListener("load", function () { setTimeout(loadAdSense, 2000); });
    }
  })();
</script>

  <title>PingThat — Herramientas de Red para Desarrolladores</title>
  <link rel="canonical" href="https://pingthat.dev/es/" />
  <link rel="alternate" hreflang="en" href="https://pingthat.dev/" />
  <link rel="alternate" hreflang="es" href="https://pingthat.dev/es/" />
  <link rel="alternate" hreflang="x-default" href="https://pingthat.dev/" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts (self-hosted). latin-ext only loaded on-demand via unicode-range
       in fonts.css — preloading it blocks FCP on EN/ES (which use latin only). -->
  <style is:inline set:html={FONTS_CSS}></style>
  <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

  <meta property="og:title" content="PingThat — Herramientas de Red para Desarrolladores" />
  <meta property="og:description" content="PingThat es una coleccion gratuita de 23 herramientas de red y seguridad — consulta DNS, verificador SSL, WHOIS, cabeceras HTTP, decodificador JWT — que se ejecutan en tu navegador o consultan APIs públicas (DoH/RDAP/registros de certs)." />
  <meta property="og:url" content="https://pingthat.dev/es" />
  <meta property="og:site_name" content="PingThat" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://pingthat.dev/og-image.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="PingThat — Herramientas de Red para Desarrolladores" />
  <meta name="twitter:description" content="PingThat es una coleccion gratuita de 23 herramientas de red y seguridad — consulta DNS, verificador SSL, WHOIS, cabeceras HTTP, decodificador JWT — que se ejecutan en tu navegador o consultan APIs públicas (DoH/RDAP/registros de certs)." />
  <meta name="twitter:image" content="https://pingthat.dev/og-image.png" />

  <script type="application/ld+json" set:html={jsonLd} />
</head>
<body>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:rounded focus:text-sm focus:font-medium" style="background: var(--color-accent); color: var(--color-bg);">Saltar al contenido</a>
  <div class="min-h-screen relative" style="background: var(--color-bg); color: var(--color-text);">

    <!-- Top-right: Guías + language toggle (Nielsen audit 2026-04-30, PT F17). -->
    <div class="absolute top-4 right-4 z-30 flex items-center gap-3">
      <a href="/es/docs/" class="text-[11px] hover:text-[var(--color-accent)] transition-colors" style="color: var(--color-text-muted);">Guías</a>
      <LangToggle lang="es" enPath="/" esPath="/es/" />
    </div>

    <!-- Hero. id="main-content" + tabindex="-1" so skip-link transfers
         keyboard focus here. Round-2 review fix 2026-04-30. -->
    <header id="main-content" tabindex="-1" class="px-6 py-16 sm:py-24 text-center max-w-3xl mx-auto">
      <p class="text-[10px] uppercase tracking-[0.2em] mb-4 font-semibold" style="color: var(--color-accent-fg);">{c.heroEyebrow}</p>
      <h1 class="text-4xl sm:text-5xl font-bold mb-4" style="color: var(--color-text);">
        {c.heroHeadingPrefix}<em class="italic" style="color: var(--color-accent-fg);">{c.heroHeadingEm}</em>
      </h1>
      <p class="text-sm sm:text-base leading-relaxed mb-8" style="color: var(--color-text-muted);">
        {c.heroText}
      </p>
      <!-- Hero search (Nielsen audit, PT F8). -->
      <div class="max-w-xl mx-auto">
        <input
          id="home-search"
          type="search"
          placeholder={`Busca en ${tools.length} herramientas — DNS, SSL, headers, JWT, subred...`}
          aria-label="Buscar herramientas"
          autocomplete="off"
          class="w-full px-4 py-3 rounded-lg text-sm"
          style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text);"
        />
      </div>
    </header>

    <!-- Tool Grid -->
    <main class="px-6 pb-16 max-w-5xl mx-auto">
      <p id="home-no-results" class="hidden text-center text-sm mb-8" style="color: var(--color-text-muted);">No hay herramientas que coincidan con tu búsqueda.</p>
      {groups.map((group) => (
        <section class="mb-12 home-group">
          <div class="flex items-center gap-3 mb-5">
            <h2 class="text-[10px] uppercase tracking-[0.15em] font-semibold" style="color: var(--color-accent-fg);">
              {groupLabelsI18n[group.label]?.es ?? group.label}
            </h2>
            <div class="flex-1 h-px" style="background: var(--color-border);"></div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {group.ids.map((id) => {
              const tool = tools.find(t => t.id === id);
              if (!tool) return null;
              const localizedName = toolNamesI18n[tool.id]?.es ?? tool.name;
              const localizedDesc = toolDescriptionsI18n[tool.id]?.es ?? tool.description;
              const searchText = [localizedName, localizedDesc, tool.id, ...(tool.keywords || [])].join(' ').toLowerCase();
              return (
                <a
                  href={`/es${tool.path}`}
                  class="card group block transition-all hover:border-[var(--color-accent)] home-tool-card"
                  style="border: 1px solid var(--color-border);"
                  data-tool-search={searchText}
                >
                  <div class="card-body" style="padding: 20px;">
                    <div class="flex items-start gap-3">
                      <span
                        class="text-xs flex items-center justify-center w-9 h-9 rounded-lg shrink-0 font-semibold font-mono"
                        style="background: var(--color-accent-dim); color: var(--color-accent-fg); border: 1px solid rgba(16,185,129,0.15);"
                        aria-hidden="true"
                      >
                        {tool.icon}
                      </span>
                      <div class="flex-1 min-w-0">
                        <h3 class="text-sm font-medium mb-1 group-hover:text-[var(--color-accent)] transition-colors" style="color: var(--color-text);">
                          {localizedName}
                        </h3>
                        <p class="text-xs leading-relaxed" style="color: var(--color-text-muted);">
                          {localizedDesc}
                        </p>
                      </div>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ))}

      <!-- Bottom CTA -->
      <div class="text-center py-12" style="border-top: 1px solid var(--color-border);">
        <p class="text-[10px] uppercase tracking-[0.15em] mb-3" style="color: var(--color-text-dim);">
          {c.bottomCtaLabel}
        </p>
        <p class="text-xs" style="color: var(--color-text-muted);">
          {c.bottomCtaText}
        </p>
      </div>
    <CrossLinks exclude="PingThat" lang="es" />
    </main>
    <!-- Footer (Nielsen audit 2026-04-30, PT F3 + F17). -->
    <footer class="px-6 py-4 border-t border-[var(--color-border)] text-[11px]" style="color: var(--color-text-dim);">
      <div class="flex justify-between items-center mb-2 gap-3 flex-wrap">
        <span>{c.footerTagline}</span>
        <span class="flex items-center gap-2 flex-wrap">
          <a href="/es/about/" class="hover:text-[var(--color-accent)] transition-colors">Acerca de</a>
          <span style="color: var(--color-border);">·</span>
          <a href="/es/privacy/" class="hover:text-[var(--color-accent)] transition-colors">{c.footerPrivacy}</a>
          <span style="color: var(--color-border);">·</span>
          <a href="/es/methodology/" class="hover:text-[var(--color-accent)] transition-colors">{c.footerMethodology}</a>
          <span style="color: var(--color-border);">·</span>
          <a href="/es/docs/" class="hover:text-[var(--color-accent)] transition-colors">Guías</a>
          <span style="color: var(--color-border);">·</span>
          <a href="https://buymeacoffee.com/allopen" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-accent)] transition-colors">Buy me a coffee</a>
        </span>
      </div>
      <!-- Identity strip ES — mismos signals Stanford T-02/T-04/T-06 -->
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-2" style="color: var(--color-text-muted); font-size: 11px;">
        <span>{c.footerMaintainedBy} · <span style="color: var(--color-text-dim);">{c.footerSince}</span></span>
        <span style="color: var(--color-border);">·</span>
        <a href={`mailto:${c.footerSupportEmail}?subject=${encodeURIComponent('PingThat — consulta')}`}
           class="hover:text-[var(--color-accent)] transition-colors inline-block py-1"
           title={c.footerSupportEmailSub}>{c.footerSupportEmail}</a>
        <span style="color: var(--color-border);">·</span>
        <span style="color: var(--color-text-dim);">{lastVerifiedFooter}</span>
      </div>
      <form id="feedback-form" action="https://formspree.io/f/mpqoddwl" method="POST" class="flex gap-2">
        <input type="hidden" name="app" value="PingThat" />
        <input type="hidden" name="page" value="" />
        <input type="hidden" name="_subject" value="" />
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
        <input type="text" name="message" placeholder="Bug, idea o sugerencia..." required
          aria-label="Bug, idea o sugerencia..."
          class="flex-1 px-3 py-1.5 rounded text-[11px]"
          style="background: var(--color-surface2); border: 1px solid var(--color-border); color: var(--color-text); font-family: 'Inter', sans-serif;"
        />
        <button type="submit" class="px-3 py-1.5 rounded text-[10px] uppercase tracking-wider"
          style="background: var(--color-surface2); border: 1px solid var(--color-border); color: var(--color-text-muted); cursor: pointer;">
          Enviar
        </button>
      </form>
    </footer>
  </div>
  <CookieConsent lang="es" />

  <!-- Feedback form: AJAX submit + toast (Nielsen audit code-review 2026-04-30). -->
  <script>
    (function () {
      const form = document.getElementById('feedback-form');
      if (!(form instanceof HTMLFormElement)) return;
      const isEs = document.documentElement.lang === 'es';
      const MSG = {
        success: isEs ? '¡Gracias por tu feedback!' : 'Thanks for your feedback!',
        error: isEs ? 'Error al enviar. Inténtalo más tarde.' : 'Error sending. Please try again later.',
      };
      function showToast(text: string, isError: boolean) {
        const toast = document.createElement('div');
        toast.setAttribute('role', 'status');
        toast.setAttribute('aria-live', 'polite');
        toast.textContent = text;
        Object.assign(toast.style, {
          position: 'fixed', bottom: '24px', left: '50%',
          transform: 'translate(-50%, 20px)', padding: '12px 20px',
          borderRadius: '8px', background: isError ? '#dc2626' : '#059669',
          color: '#fff', fontSize: '13px', fontWeight: '500', zIndex: '9999',
          boxShadow: '0 10px 30px rgba(0,0,0,0.35)', opacity: '0',
          transition: 'opacity .25s ease, transform .25s ease',
          cursor: 'pointer', maxWidth: '90vw',
        });
        toast.title = isEs ? 'Clic para cerrar' : 'Click to dismiss';
        document.body.appendChild(toast);
        requestAnimationFrame(() => {
          toast.style.opacity = '1';
          toast.style.transform = 'translate(-50%, 0)';
        });
        let dismissed = false;
        const dismiss = () => {
          if (dismissed) return;
          dismissed = true;
          toast.style.opacity = '0';
          toast.style.transform = 'translate(-50%, 20px)';
          setTimeout(() => toast.remove(), 300);
        };
        toast.addEventListener('click', dismiss);
        setTimeout(dismiss, 5000);
      }
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = form.querySelector('button[type="submit"]');
        const data = new FormData(form);
        data.set('page', location.href);
        const appName = String(data.get('app') || 'PingThat');
        data.set('_subject', `[${appName}] ${location.pathname}`);
        if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;
        try {
          const res = await fetch(form.action, {
            method: 'POST', body: data,
            headers: { Accept: 'application/json' },
          });
          if (res.ok) { showToast(MSG.success, false); form.reset(); }
          else { showToast(MSG.error, true); }
        } catch {
          showToast(MSG.error, true);
        } finally {
          if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
        }
      });
    })();
  </script>

  <!-- Hero search filter (Nielsen audit PT F8). -->
  <script>
    const heroInput = document.getElementById('home-search') as HTMLInputElement | null;
    const heroNoResults = document.getElementById('home-no-results');
    if (heroInput) {
      const apply = () => {
        const q = heroInput.value.toLowerCase().trim();
        let anyMatch = false;
        document.querySelectorAll<HTMLElement>('.home-tool-card').forEach((el) => {
          const text = el.dataset.toolSearch || '';
          const match = !q || text.includes(q);
          el.style.display = match ? '' : 'none';
          if (match) anyMatch = true;
        });
        document.querySelectorAll<HTMLElement>('.home-group').forEach((section) => {
          const visible = Array.from(section.querySelectorAll<HTMLElement>('.home-tool-card'))
            .some((c) => c.style.display !== 'none');
          section.style.display = visible ? '' : 'none';
        });
        if (heroNoResults) heroNoResults.classList.toggle('hidden', !q || anyMatch);
      };
      heroInput.addEventListener('input', apply);
      heroInput.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && heroInput.value) {
          heroInput.value = '';
          apply();
        }
      });
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          heroInput.focus();
          heroInput.select();
        }
      });
    }
  </script>
</body>
</html>
