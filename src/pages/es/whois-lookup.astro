---
import Layout from "../../layouts/Layout.astro";
import WhoisLookup from "../../components/WhoisLookup.svelte";
import SeoContent from "../../components/SeoContent.astro";
import SeoBlock from "../../components/SeoBlock.astro";
import { pageI18n } from "../../i18n/pages";
const p = pageI18n["whois-lookup"].es;
---
<Layout title={p.title} description={p.description} activeToolId="whois-lookup" lang="es">
  <WhoisLookup client:only="svelte" lang="es" />
  <SeoContent heading={p.seoHeading} text={p.seoText} relatedToolIds={["dns-lookup", "ssl-checker", "redirect-checker"]} lang="es" />
  <SeoBlock heading={p.seoBlockHeading} text={p.seoBlockText} features={p.seoFeatures} lang="es" />
</Layout>
