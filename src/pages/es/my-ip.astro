---
import Layout from "../../layouts/Layout.astro";
import MyIp from "../../components/MyIp.svelte";
import SeoContent from "../../components/SeoContent.astro";
import SeoBlock from "../../components/SeoBlock.astro";
import { pageI18n } from "../../i18n/pages";

const p = pageI18n["my-ip"].es;
---

<Layout
  title={p.title}
  description={p.description}
  activeToolId="my-ip"
  lang="es"
>
  <MyIp client:only="svelte" lang="es" />

  <SeoContent
    heading={p.seoHeading}
    text={p.seoText}
    relatedToolIds={["privacy-check", "webrtc-leak-test"]}
    lang="es"
  />

  <SeoBlock
    heading={p.seoBlockHeading}
    text={p.seoBlockText}
    features={p.seoFeatures}
    lang="es"
  />
</Layout>
