---
import Layout from "../../layouts/Layout.astro";
import CompareLinks from "../../components/CompareLinks.astro";
import DnsLookup from "../../components/DnsLookup.svelte";
import SeoContent from "../../components/SeoContent.astro";
import SeoBlock from "../../components/SeoBlock.astro";
import ToolContent from "../../components/ToolContent.astro";
import { pageI18n } from "../../i18n/pages";
const p = pageI18n["dns-lookup"].es;
---
<Layout title={p.title} description={p.description} activeToolId="dns-lookup" lang="es">
  <DnsLookup client:only="svelte" lang="es" />
  <SeoContent heading={p.seoHeading} text={p.seoText} relatedToolIds={["my-ip", "whois-lookup", "ssl-checker"]} lang="es" />
  <ToolContent howHeading={p.howHeading} howSteps={p.howSteps} useCasesHeading={p.useCasesHeading} useCases={p.useCases} faqHeading={p.faqHeading} faqs={p.faqs} lang="es" />
  <SeoBlock heading={p.seoBlockHeading} text={p.seoBlockText} features={p.seoFeatures} lang="es" />

  <CompareLinks lang="es" competitors={["mxtoolbox", "dnschecker"]} />
</Layout>
