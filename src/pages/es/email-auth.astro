---
import Layout from "../../layouts/Layout.astro";
import EmailAuth from "../../components/EmailAuth.svelte";
import SeoContent from "../../components/SeoContent.astro";
import SeoBlock from "../../components/SeoBlock.astro";
import { pageI18n } from "../../i18n/pages";
const p = pageI18n["email-auth"].es;
---
<Layout title={p.title} description={p.description} activeToolId="email-auth" lang="es">
  <EmailAuth client:only="svelte" lang="es" />
  <SeoContent heading={p.seoHeading} text={p.seoText} relatedToolIds={["dns-lookup", "ssl-checker", "http-headers"]} lang="es" />
  <SeoBlock heading={p.seoBlockHeading} text={p.seoBlockText} features={p.seoFeatures} lang="es" />
</Layout>
