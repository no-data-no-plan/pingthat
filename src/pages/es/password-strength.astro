---
import Layout from "../../layouts/Layout.astro";
import PasswordStrength from "../../components/PasswordStrength.svelte";
import SeoContent from "../../components/SeoContent.astro";
import SeoBlock from "../../components/SeoBlock.astro";
import ToolContent from "../../components/ToolContent.astro";
import { pageI18n } from "../../i18n/pages";

const p = pageI18n["password-strength"].es;
---

<Layout
  title={p.title}
  description={p.description}
  activeToolId="password-strength"
  lang="es"
>
  <PasswordStrength client:load lang="es" />

  <SeoContent
    heading={p.seoHeading}
    text={p.seoText}
    relatedToolIds={["privacy-check", "jwt-decoder", "webrtc-leak-test"]}
    lang="es"
  />

  <ToolContent
    howHeading={p.howHeading}
    howSteps={p.howSteps}
    useCasesHeading={p.useCasesHeading}
    useCases={p.useCases}
    faqHeading={p.faqHeading}
    faqs={p.faqs}
    lang="es"
  />

    <SeoBlock
    heading={p.seoBlockHeading}
    text={p.seoBlockText}
    features={p.seoFeatures}
    lang="es"
  />
</Layout>
