---
import Layout from "../../layouts/Layout.astro";
import ReverseDns from "../../components/ReverseDns.svelte";
import SeoContent from "../../components/SeoContent.astro";
import SeoBlock from "../../components/SeoBlock.astro";
import { pageI18n } from "../../i18n/pages";
const p = pageI18n["reverse-dns"].es;
---
<Layout title={p.title} description={p.description} activeToolId="reverse-dns" lang="es">
  <ReverseDns client:only="svelte" lang="es" />
  <SeoContent heading={p.seoHeading} text={p.seoText} relatedToolIds={["dns-lookup", "my-ip", "whois-lookup"]} lang="es" />
  <SeoBlock heading={p.seoBlockHeading} text={p.seoBlockText} features={p.seoFeatures} lang="es" />
</Layout>
