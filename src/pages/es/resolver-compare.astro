---
import Layout from "../../layouts/Layout.astro";
import ResolverCompare from "../../components/ResolverCompare.svelte";
import SeoContent from "../../components/SeoContent.astro";
import SeoBlock from "../../components/SeoBlock.astro";
import { pageI18n } from "../../i18n/pages";
const p = pageI18n["resolver-compare"].es;
---
<Layout title={p.title} description={p.description} activeToolId="resolver-compare" lang="es">
  <ResolverCompare client:only="svelte" lang="es" />
  <SeoContent heading={p.seoHeading} text={p.seoText} relatedToolIds={["dns-lookup", "dnssec-check", "reverse-dns"]} lang="es" />
  <SeoBlock heading={p.seoBlockHeading} text={p.seoBlockText} features={p.seoFeatures} lang="es" />
</Layout>
