---
import Layout from "../layouts/Layout.astro";
import CaaLookup from "../components/CaaLookup.svelte";
import SeoContent from "../components/SeoContent.astro";
import SeoBlock from "../components/SeoBlock.astro";
import { pageI18n } from "../i18n/pages";

const p = pageI18n["caa-lookup"].en;
---

<Layout
  title={p.title}
  description={p.description}
  activeToolId="caa-lookup"
>
  <CaaLookup client:only="svelte" />

  <SeoContent
    heading={p.seoHeading}
    text={p.seoText}
    relatedToolIds={["ssl-checker", "dns-lookup", "whois-lookup"]}
  />

  <SeoBlock
    heading={p.seoBlockHeading}
    text={p.seoBlockText}
    features={p.seoFeatures}
  />
</Layout>
