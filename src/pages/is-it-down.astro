---
import Layout from "../layouts/Layout.astro";
import IsItDown from "../components/IsItDown.svelte";
import SeoContent from "../components/SeoContent.astro";
import SeoBlock from "../components/SeoBlock.astro";
import { pageI18n } from "../i18n/pages";

const p = pageI18n["is-it-down"].en;
---

<Layout
  title={p.title}
  description={p.description}
  activeToolId="is-it-down"
>
  <IsItDown client:only="svelte" />

  <SeoContent
    heading={p.seoHeading}
    text={p.seoText}
    relatedToolIds={["is-it-up", "dns-lookup", "http-headers"]}
  />

  <SeoBlock
    heading={p.seoBlockHeading}
    text={p.seoBlockText}
    features={p.seoFeatures}
  />
</Layout>
