---
import { tools, groups } from "../lib/tools";
import type { Lang } from "../i18n/index";
import { getCommon } from "../i18n/common";
import { toolNamesI18n, groupLabelsI18n } from "../i18n/pages";

interface Props {
  activeToolId: string;
  lang?: Lang;
}

const { activeToolId, lang = "en" } = Astro.props;
const c = getCommon(lang);
const langPrefix = lang === "es" ? "/es" : "";
---

<!-- Overlay -->
<div id="sidebar-overlay" class="fixed inset-0 bg-black/50 z-40 hidden lg:hidden"></div>

<!-- Sidebar -->
<aside
  id="sidebar"
  class="fixed lg:sticky top-0 left-0 z-50 h-screen w-64 flex flex-col border-r border-[var(--color-border)] -translate-x-full lg:translate-x-0 transition-transform"
  style="background: var(--color-bg);"
>
  <!-- Brand — our signal-bars mark (favicon), inlined so it tracks the
       theme accent via currentColor instead of the favicon's own
       prefers-color-scheme media query. Name in fg-1, mark in accent. -->
  <div class="px-5 py-4 border-b border-[var(--color-border)]">
    <a href={`${langPrefix}/`} class="flex items-center gap-2.5" aria-label="PingThat — home">
      <svg viewBox="0 0 32 32" width="22" height="22" fill="none" aria-hidden="true" style="color: var(--color-accent-fg); flex: none;">
        <rect fill="currentColor" x="2" y="4" width="3" height="3" rx="0.5" opacity="0.15"/><rect fill="currentColor" x="2" y="9" width="3" height="3" rx="0.5" opacity="0.3"/><rect fill="currentColor" x="2" y="14" width="3" height="3" rx="0.5" opacity="0.55"/><rect fill="currentColor" x="2" y="19" width="3" height="3" rx="0.5" opacity="0.8"/><rect fill="currentColor" x="2" y="24" width="3" height="3" rx="0.5" opacity="1"/>
        <rect fill="currentColor" x="8" y="1" width="3" height="3" rx="0.5" opacity="0.1"/><rect fill="currentColor" x="8" y="6" width="3" height="3" rx="0.5" opacity="0.2"/><rect fill="currentColor" x="8" y="11" width="3" height="3" rx="0.5" opacity="0.35"/><rect fill="currentColor" x="8" y="16" width="3" height="3" rx="0.5" opacity="0.55"/><rect fill="currentColor" x="8" y="21" width="3" height="3" rx="0.5" opacity="0.8"/><rect fill="currentColor" x="8" y="26" width="3" height="3" rx="0.5" opacity="1"/>
        <rect fill="currentColor" x="14" y="8" width="3" height="3" rx="0.5" opacity="0.2"/><rect fill="currentColor" x="14" y="13" width="3" height="3" rx="0.5" opacity="0.4"/><rect fill="currentColor" x="14" y="18" width="3" height="3" rx="0.5" opacity="0.7"/><rect fill="currentColor" x="14" y="23" width="3" height="3" rx="0.5" opacity="1"/>
        <rect fill="currentColor" x="20" y="3" width="3" height="3" rx="0.5" opacity="0.1"/><rect fill="currentColor" x="20" y="8" width="3" height="3" rx="0.5" opacity="0.2"/><rect fill="currentColor" x="20" y="13" width="3" height="3" rx="0.5" opacity="0.4"/><rect fill="currentColor" x="20" y="18" width="3" height="3" rx="0.5" opacity="0.6"/><rect fill="currentColor" x="20" y="23" width="3" height="3" rx="0.5" opacity="0.85"/><rect fill="currentColor" x="20" y="28" width="3" height="3" rx="0.5" opacity="1"/>
        <rect fill="currentColor" x="27" y="6" width="3" height="3" rx="0.5" opacity="0.2"/><rect fill="currentColor" x="27" y="11" width="3" height="3" rx="0.5" opacity="0.45"/><rect fill="currentColor" x="27" y="16" width="3" height="3" rx="0.5" opacity="0.7"/><rect fill="currentColor" x="27" y="21" width="3" height="3" rx="0.5" opacity="1"/>
      </svg>
      <span class="text-lg font-bold" style="color: var(--color-text); letter-spacing: -0.02em;">PingThat</span>
    </a>
    <p class="text-[10px] mt-1 ml-8" style="color: var(--color-text-dim); letter-spacing: 0.1em;">{c.networkToolsUppercase}</p>
  </div>

  <!-- Search -->
  <div class="px-4 py-3 border-b border-[var(--color-border)]">
    <input
      id="sidebar-search"
      type="text"
      placeholder={c.searchTools}
      aria-label={c.searchTools}
      class="w-full px-3 py-3 rounded-lg text-xs min-h-[44px]"
      style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text);"
    />
  </div>

  <!-- Docs nav -->
  <div class="px-4 pt-3 pb-1">
    <a
      href={lang === "es" ? "/es/docs/" : "/docs/"}
      aria-current={activeToolId === "docs" ? "page" : undefined}
      class:list={[
        "flex items-center gap-2 px-3 py-2 text-xs font-medium rounded transition-colors",
        activeToolId === "docs"
          ? "text-[var(--color-accent-fg)] bg-[var(--color-accent-dim)] shadow-[inset_2px_0_0_var(--color-accent)]"
          : "text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[rgba(255,255,255,0.03)]",
      ]}
    >
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 2h7l3 3v9a1 1 0 01-1 1H3a1 1 0 01-1-1V3a1 1 0 011-1z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
        <path d="M10 2v3h3M5 8h6M5 11h6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      </svg>
      <span>{lang === "es" ? "Guías" : "Guides"}</span>
    </a>
  </div>

  <!-- Tool list -->
  <nav id="sidebar-nav" class="flex-1 overflow-y-auto py-3">
    {groups.map((group) => (
      <div class="mb-2 sidebar-group" data-expanded="true">
        <button
          class="w-full px-5 py-3 flex items-center justify-between group-toggle min-h-[44px]"
          style="background: none; border: none; cursor: pointer;"
        >
          <span class="text-[9px] uppercase tracking-[0.12em]" style="color: var(--color-text-dim);">
            {groupLabelsI18n[group.label]?.[lang] ?? group.label}
          </span>
          <svg class="group-chevron w-3 h-3 transition-transform" style="color: var(--color-text-dim);" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M3 5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="group-items">
          {group.ids.map((id) => {
            const tool = tools.find(t => t.id === id);
            if (!tool) return null;
            const isActive = tool.id === activeToolId;
            return (
              <a
                href={`${langPrefix}${tool.path}`}
                aria-current={isActive ? "page" : undefined}
                class:list={[
                  "sidebar-link flex items-center gap-3 px-5 py-2 text-xs transition-colors",
                  isActive
                    ? "text-[var(--color-accent-fg)] bg-[var(--color-accent-dim)] shadow-[inset_2px_0_0_var(--color-accent)]"
                    : "text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[rgba(255,255,255,0.03)]",
                ]}
                data-tool-name={(toolNamesI18n[tool.id]?.[lang] ?? tool.name).toLowerCase()}
              >
                <span class="text-[10px] w-5 text-center font-mono opacity-80" style="font-weight: 600;" aria-hidden="true">{tool.icon}</span>
                <span>{toolNamesI18n[tool.id]?.[lang] ?? tool.name}</span>
              </a>
            );
          })}
        </div>
      </div>
    ))}
  </nav>

  <!-- Footer -->
  <div class="px-5 py-3 border-t border-[var(--color-border)]">
    <p class="text-[10px]" style="color: var(--color-text-dim);">{c.noDataCollectedFull}</p>
  </div>
</aside>

<!-- Sidebar scripts -->
<script>
  // Collapsible groups
  document.querySelectorAll('.group-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const group = btn.closest('.sidebar-group');
      if (!group) return;
      const expanded = group.getAttribute('data-expanded') === 'true';
      group.setAttribute('data-expanded', String(!expanded));
      const items = group.querySelector('.group-items') as HTMLElement;
      const chevron = group.querySelector('.group-chevron') as HTMLElement;
      if (items) items.style.display = expanded ? 'none' : '';
      if (chevron) chevron.style.transform = expanded ? 'rotate(-90deg)' : '';
    });
  });

  // Search filter
  const searchInput = document.getElementById('sidebar-search') as HTMLInputElement;
  if (searchInput) {
    searchInput.addEventListener('input', () => {
      const q = searchInput.value.toLowerCase().trim();
      document.querySelectorAll('.sidebar-link').forEach((link) => {
        const name = link.getAttribute('data-tool-name') || '';
        (link as HTMLElement).style.display = !q || name.includes(q) ? '' : 'none';
      });
      // Show all groups when searching
      document.querySelectorAll('.sidebar-group').forEach((g) => {
        const items = g.querySelector('.group-items') as HTMLElement;
        if (items && q) items.style.display = '';
      });
    });

    // Global "/" focus accelerator (Nielsen audit 2026-04-30, PT F12).
    // Skip when the user is already typing into another input/textarea
    // or contentEditable to avoid stealing the slash keystroke.
    document.addEventListener('keydown', (e) => {
      if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
      const t = e.target;
      const isEditable =
        t instanceof HTMLInputElement ||
        t instanceof HTMLTextAreaElement ||
        (t instanceof HTMLElement && t.isContentEditable);
      if (isEditable) return;
      e.preventDefault();
      searchInput.focus();
      searchInput.select();
    });
  }
</script>
