---
import { tools } from "../lib/tools";
import type { Lang } from "../i18n/index";
import { getCommon } from "../i18n/common";
import { toolNamesI18n } from "../i18n/pages";

interface Props {
  heading: string;
  text: string;
  relatedToolIds: string[];
  lang?: Lang;
}

const { heading, text, relatedToolIds, lang = "en" } = Astro.props;
const c = getCommon(lang);
const prefix = lang === "en" ? "" : `/${lang}`;
const relatedTools = relatedToolIds
  .map((id) => tools.find((t) => t.id === id))
  .filter(Boolean) as typeof tools;
---

<section class="px-8 py-5 border-t border-[var(--color-border)]" style="background: var(--color-surface);">
  <h2 class="text-[10px] uppercase tracking-[0.12em] mb-2" style="color: var(--color-accent-fg);">{heading}</h2>
  <p class="text-xs leading-relaxed" style="color: var(--color-text-muted);">{text}</p>
  {relatedTools.length > 0 && (
    <div class="flex flex-wrap gap-2 mt-3">
      <span class="text-[10px]" style="color: var(--color-text-dim);">{c.related}</span>
      {relatedTools.map((tool) => (
        <a href={`${prefix}${tool.path}`} class="text-[10px] underline" data-related-tool style="color: var(--color-accent-fg);">
          {toolNamesI18n[tool.id]?.[lang] ?? tool.name}
        </a>
      ))}
    </div>
  )}
</section>

<script>
  // Carry shareable query params (domain/host/url) into related-tool links so
  // DNS → WHOIS → SSL → DNSSEC chains preserve the user's input context.
  // CW-PT-04 / Theme A starter (2026-05-02). Pure client-side enhancement —
  // SSR markup stays plain anchors, so noscript + crawlers see the canonical
  // related-tool URLs.
  //
  // Rewrite is **lazy** (per-link, on pointer/focus) so it picks up params the
  // user added after page load via in-tool lookups (which call updateQuery →
  // replaceState). Rewriting once on DOMContentLoaded would miss that flow.
  (() => {
    const CARRY_KEYS = ['domain', 'host', 'url'];
    const ORIGINAL_HREF = '__ptOriginalHref';

    function rewrite(a: HTMLAnchorElement) {
      try {
        const original = (a as any)[ORIGINAL_HREF] ?? a.getAttribute('href') ?? '';
        (a as any)[ORIGINAL_HREF] = original;
        const url = new URL(original, window.location.href);
        const here = new URLSearchParams(window.location.search);
        let touched = false;
        for (const k of CARRY_KEYS) {
          const v = here.get(k);
          if (v && !url.searchParams.has(k)) {
            url.searchParams.set(k, v);
            touched = true;
          }
        }
        if (touched) a.href = url.toString();
      } catch {
        /* malformed href — leave alone */
      }
    }

    const links = document.querySelectorAll<HTMLAnchorElement>('a[data-related-tool]');
    if (!links.length) return;
    const events = ['pointerdown', 'focus', 'mouseenter', 'touchstart', 'click'];
    links.forEach((a) => {
      for (const ev of events) {
        a.addEventListener(ev, () => rewrite(a), { passive: true });
      }
    });
  })();
</script>
